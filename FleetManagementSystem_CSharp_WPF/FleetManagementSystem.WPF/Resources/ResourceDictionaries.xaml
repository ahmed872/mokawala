<!-- ============================================================================
     DELIVERABLE 5: Shared Resource Dictionaries for Arabic RTL Styling
     Fleet Management System - C# WPF Implementation
     ============================================================================ -->

<!-- Fonts.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Arabic Font Family -->
    <FontFamily x:Key="ArabicFontFamily">Segoe UI, Tahoma, Arial</FontFamily>
    
    <!-- Font Sizes -->
    <System:Double x:Key="FontSize.ExtraSmall">10</System:Double>
    <System:Double x:Key="FontSize.Small">12</System:Double>
    <System:Double x:Key="FontSize.Normal">13</System:Double>
    <System:Double x:Key="FontSize.Medium">14</System:Double>
    <System:Double x:Key="FontSize.Large">16</System:Double>
    <System:Double x:Key="FontSize.ExtraLarge">18</System:Double>
    <System:Double x:Key="FontSize.Heading1">28</System:Double>
    <System:Double x:Key="FontSize.Heading2">24</System:Double>
    <System:Double x:Key="FontSize.Heading3">20</System:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeight.Normal">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>
    <FontWeight x:Key="FontWeight.SemiBold">SemiBold</FontWeight>

</ResourceDictionary>

<!-- ============================================================================ -->

<!-- Colors.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Colors -->
    <Color x:Key="Color.Primary">#1976D2</Color>
    <Color x:Key="Color.PrimaryDark">#1565C0</Color>
    <Color x:Key="Color.PrimaryVeryDark">#0D47A1</Color>
    <Color x:Key="Color.PrimaryLight">#64B5F6</Color>
    <Color x:Key="Color.PrimaryVeryLight">#E3F2FD</Color>

    <!-- Secondary Colors -->
    <Color x:Key="Color.Secondary">#FF6F00</Color>
    <Color x:Key="Color.SecondaryDark">#E65100</Color>
    <Color x:Key="Color.SecondaryLight">#FFB74D</Color>

    <!-- Status Colors -->
    <Color x:Key="Color.Success">#388E3C</Color>
    <Color x:Key="Color.SuccessLight">#C8E6C9</Color>
    <Color x:Key="Color.Warning">#F57C00</Color>
    <Color x:Key="Color.WarningLight">#FFE0B2</Color>
    <Color x:Key="Color.Error">#C62828</Color>
    <Color x:Key="Color.ErrorLight">#FFEBEE</Color>
    <Color x:Key="Color.Info">#1976D2</Color>
    <Color x:Key="Color.InfoLight">#E3F2FD</Color>

    <!-- Neutral Colors -->
    <Color x:Key="Color.Background">#FFFFFF</Color>
    <Color x:Key="Color.Surface">#F5F5F5</Color>
    <Color x:Key="Color.Border">#EEEEEE</Color>
    <Color x:Key="Color.Divider">#BDBDBD</Color>
    <Color x:Key="Color.Text.Primary">#212121</Color>
    <Color x:Key="Color.Text.Secondary">#757575</Color>
    <Color x:Key="Color.Text.Disabled">#BDBDBD</Color>
    <Color x:Key="Color.Text.Hint">#9E9E9E</Color>

    <!-- Disabled State -->
    <Color x:Key="Color.Disabled">#F5F5F5</Color>
    <Color x:Key="Color.DisabledText">#BDBDBD</Color>

</ResourceDictionary>

<!-- ============================================================================ -->

<!-- Brushes.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="PrimaryVeryDarkBrush" Color="#0D47A1"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="PrimaryVeryLightBrush" Color="#E3F2FD"/>

    <!-- Secondary Brushes -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FF6F00"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="#E65100"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="#FFB74D"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#388E3C"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#C8E6C9"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F57C00"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FFE0B2"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="#FFEBEE"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#E3F2FD"/>

    <!-- Neutral Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="TextHintBrush" Color="#9E9E9E"/>

    <!-- Disabled State -->
    <SolidColorBrush x:Key="DisabledBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#BDBDBD"/>

    <!-- Shadow Effect -->
    <DropShadowEffect x:Key="DropShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>

</ResourceDictionary>

<!-- ============================================================================ -->

<!-- Converters.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FleetManagementSystem.WPF.Converters">

    <!-- Boolean to Visibility Converter -->
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    <!-- Inverse Boolean to Visibility Converter -->
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

    <!-- String to Visibility Converter -->
    <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

    <!-- Inverse Boolean Converter -->
    <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

    <!-- Enum to String Converter -->
    <local:EnumToStringConverter x:Key="EnumToStringConverter"/>

    <!-- Date to String Converter -->
    <local:DateToStringConverter x:Key="DateToStringConverter"/>

    <!-- ByteArray to Image Converter -->
    <local:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>

</ResourceDictionary>

<!-- ============================================================================ -->

<!-- Styles.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button Styles -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryVeryDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Style.Triggers>
    </Style>

    <!-- TextBox Styles -->
    <Style x:Key="StandardTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Styles -->
    <Style x:Key="StandardComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <!-- DataGrid Styles -->
    <Style x:Key="StandardDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
        <Setter Property="RowHeight" Value="35"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- TextBlock Styles -->
    <Style x:Key="Heading1Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading1}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <Style x:Key="Heading2Style" TargetType="TextBlock" BasedOn="{StaticResource Heading1Style}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading2}"/>
    </Style>

    <Style x:Key="Heading3Style" TargetType="TextBlock" BasedOn="{StaticResource Heading1Style}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading3}"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Normal}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{StaticResource TextHintBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

</ResourceDictionary>
