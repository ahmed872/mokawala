<Window x:Class="FleetManagementSystem.WPF.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات قاعدة البيانات"
        Width="540"
        Height="560"
        WindowStartupLocation="CenterOwner"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="BaseActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="22"
                Padding="24"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Background="{StaticResource AccentPaleBrush}"
                            CornerRadius="16"
                            Padding="12,5"
                            HorizontalAlignment="Right">
                        <TextBlock Text="إدارة اتصال التطبيق"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="إعداد الاتصال بقاعدة البيانات"
                               Margin="0,14,0,0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap">
                        بيئة التشغيل الأساسية تعتمد على MySQL على الشبكة المحلية. يمكن استخدام SQLite فقط للتجربة أو التطوير المحلي.
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,18,0,18"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <TextBlock x:Name="CurrentPathTextBlock"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="نوع قاعدة البيانات" />
                    <ComboBox x:Name="ProviderComboBox"
                              Grid.Row="1"
                              Margin="0,6,0,12"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="ProviderComboBox_SelectionChanged">
                        <ComboBoxItem Content="MySQL على الشبكة" Tag="MySql" />
                        <ComboBoxItem Content="SQLite محلي" Tag="Sqlite" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="عنوان السيرفر / IP" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="المنفذ" />
                    <TextBox x:Name="ServerTextBox"
                             Grid.Row="3"
                             Margin="0,6,10,12"
                             Style="{StaticResource AppTextBoxStyle}" />
                    <TextBox x:Name="PortTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,6,0,12"
                             Style="{StaticResource AppTextBoxStyle}" />

                    <TextBlock Grid.Row="4" Text="اسم قاعدة البيانات" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="اسم المستخدم" />
                    <TextBox x:Name="DatabaseTextBox"
                             Grid.Row="5"
                             Margin="0,6,10,12"
                             Style="{StaticResource AppTextBoxStyle}" />
                    <TextBox x:Name="UsernameTextBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             Margin="0,6,0,12"
                             Style="{StaticResource AppTextBoxStyle}" />

                    <TextBlock Grid.Row="6" Text="كلمة المرور" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="SSL" />
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Row="7"
                                 Margin="0,6,10,12"
                                 Style="{StaticResource AppPasswordBoxStyle}" />
                    <CheckBox x:Name="UseSslCheckBox"
                              Grid.Row="7"
                              Grid.Column="1"
                              Margin="0,10,0,0"
                              Content="تفعيل SSL عند الحاجة" />

                    <StackPanel x:Name="SqlitePanel"
                                Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Visibility="Collapsed">
                        <TextBlock Text="مسار ملف SQLite" />
                        <TextBox x:Name="SqlitePathTextBox"
                                 Margin="0,6,0,12"
                                 Style="{StaticResource AppTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3">
                    <TextBlock x:Name="ResultTextBlock"
                               Margin="0,0,0,12"
                               Foreground="#0F5132"
                               TextWrapping="Wrap" />
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                Click="TestConnectionButton_Click">
                            اختبار الاتصال
                        </Button>
                        <Button Style="{StaticResource BaseActionButtonStyle}"
                                Click="SaveButton_Click">
                            حفظ
                        </Button>
                        <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                Margin="0"
                                Click="CancelButton_Click">
                            إلغاء
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
