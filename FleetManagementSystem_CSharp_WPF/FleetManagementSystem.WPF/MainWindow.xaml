                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم" Binding="{Binding Id}" IsReadOnly="True" Width="0.5*" />
                            <DataGridTemplateColumn Header="العربية" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VehiclePlateNumber}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=VehiclesForBinding}"
                                                  DisplayMemberPath="PlateNumber"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding VehicleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="رقم العهدة" Binding="{Binding CustodyNumber}" Width="1*" />
                            <DataGridTextColumn Header="المستلم" Binding="{Binding CustodianName}" Width="1.15*" />
                            <DataGridTextColumn Header="الوظيفة" Binding="{Binding CustodianPosition}" Width="1*" />
                            <DataGridTextColumn Header="تاريخ التسليم" Binding="{Binding HandoverDate, StringFormat=yyyy-MM-dd}" Width="1*" />
                            <DataGridTextColumn Header="تاريخ الإرجاع" Binding="{Binding ReturnDate, StringFormat=yyyy-MM-dd}" Width="1*" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="0.85*" />
                            <DataGridTextColumn Header="تقييم الحالة" Binding="{Binding VehicleConditionRating, StringFormat=0.##}" Width="0.85*" />
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="1.25*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="البيانات الأساسية" Tag="MasterData">
                <TabControl>
                    <TabItem Header="أنواع المركبات">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddVehicleTypeButton_Click">إضافة</Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveVehicleTypeButton_Click">حفظ المحدد</Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteVehicleTypeButton_Click">حذف المحدد</Button>
                            </WrapPanel>
                            <DataGrid x:Name="VehicleTypesGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="حالات العقود">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddContractStatusButton_Click">إضافة</Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveContractStatusButton_Click">حفظ المحدد</Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteContractStatusButton_Click">حذف المحدد</Button>
                            </WrapPanel>
                            <DataGrid x:Name="ContractStatusesGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="أنواع الصيانة">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddMaintenanceTypeButton_Click">إضافة</Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveMaintenanceTypeButton_Click">حفظ المحدد</Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteMaintenanceTypeButton_Click">حذف المحدد</Button>
                            </WrapPanel>
                            <DataGrid x:Name="MaintenanceTypesGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="مزودو الخدمة">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddServiceProviderButton_Click">إضافة</Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveServiceProviderButton_Click">حفظ المحدد</Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteServiceProviderButton_Click">حذف المحدد</Button>
                            </WrapPanel>
                            <DataGrid x:Name="ServiceProvidersGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="التقارير" Tag="Reports">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <TextBlock Margin="0,10,12,0" VerticalAlignment="Center" Text="نوع التقرير:" Foreground="{StaticResource TextBrush}" />
                        <ComboBox x:Name="ReportTypeComboBox" Width="220" Style="{StaticResource AppComboBoxStyle}" SelectedIndex="0" SelectionChanged="ReportTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="المركبات" Tag="vehicles" />
                            <ComboBoxItem Content="تشغيلات العربية" Tag="vehicletrips" />
                            <ComboBoxItem Content="تراخيص العربيات" Tag="vehiclelicenses" />
                            <ComboBoxItem Content="التأمينات" Tag="insurance" />
                            <ComboBoxItem Content="العقود" Tag="contracts" />
                            <ComboBoxItem Content="الصيانة" Tag="maintenance" />
                            <ComboBoxItem Content="الزيوت" Tag="oilchanges" />
                            <ComboBoxItem Content="الخزينة" Tag="treasury" />
                        </ComboBox>
                        <StackPanel x:Name="ReportVehicleFilterPanel"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBlock Margin="16,10,12,0"
                                       VerticalAlignment="Center"
                                       Text="العربية:"
                                       Foreground="{StaticResource TextBrush}" />
                            <ComboBox x:Name="ReportVehicleComboBox"
                                      Width="210"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      DisplayMemberPath="PlateNumber"
                                      SelectedValuePath="Id" />
                        </StackPanel>
                        <TextBlock Margin="16,10,8,0"
                                   VerticalAlignment="Center"
                                   Text="من:"
                                   Foreground="{StaticResource TextBrush}" />
                        <DatePicker x:Name="ReportStartDatePicker"
                                    Width="130"
                                    Height="40" />
                        <TextBlock Margin="12,10,8,0"
                                   VerticalAlignment="Center"
                                   Text="إلى:"
                                   Foreground="{StaticResource TextBrush}" />
                        <DatePicker x:Name="ReportEndDatePicker"
                                    Width="130"
                                    Height="40" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Click="GenerateReportButton_Click">توليد التقرير</Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="عرض مستند التقرير"
                                Click="ShowReportA5Button_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"
                                         FlowDirection="LeftToRight">
                                    <Path Style="{StaticResource DocumentIconPathStyle}" />
                                </Viewbox>
                                <TextBlock Text="التقرير" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="ExportReportCsvButton_Click">CSV</Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="ExportReportExcelButton_Click">Excel</Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="PrintReportPdfButton_Click">PDF/طباعة</Button>
                        <Button Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" Click="DeleteReportButton_Click">حذف التقرير</Button>
                    </WrapPanel>

                    <DataGrid x:Name="ReportsGrid"
                              Grid.Row="1"
                              AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                              ColumnWidth="*"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Margin="0,12,0,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="مستند"
                                                    HeaderTemplate="{StaticResource DocumentColumnHeaderTemplate}"
                                                    Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GridDocumentButtonStyle}"
                                                ToolTip="عرض مستند التقرير"
                                                Click="ShowReportRowA5Button_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="المستخدمون والصلاحيات" Tag="Users">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddUserButton_Click">إضافة مستخدم</Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveUserButton_Click">حفظ المحدد</Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource AccentSoftBrush}" Click="RefreshUsersButton_Click">تحديث</Button>
                        <Button Style="{StaticResource DangerButtonStyle}" Click="ToggleUserStatusButton_Click">تفعيل/إيقاف</Button>
                    </WrapPanel>
                    <DataGrid x:Name="UsersGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn" />
                </DockPanel>
            </TabItem>

            <TabItem Header="الإعدادات" Tag="Settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="بيانات الشركة">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="اسم الشركة" />
                            <TextBox x:Name="CompanyNameTextBox" Grid.Row="1" Margin="0,6,10,10" Style="{StaticResource AppTextBoxStyle}" />
                            <TextBlock Grid.Column="1" Text="الاسم الإنجليزي" />
                            <TextBox x:Name="CompanyNameEnTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,10" Style="{StaticResource AppTextBoxStyle}" />

                            <TextBlock Grid.Row="2" Text="العنوان" />
                            <TextBox x:Name="CompanyAddressTextBox" Grid.Row="3" Margin="0,6,10,10" Style="{StaticResource AppTextBoxStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="الهاتف" />
                            <TextBox x:Name="CompanyPhoneTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6,0,10" Style="{StaticResource AppTextBoxStyle}" />

                            <TextBlock Grid.Row="4" Text="البريد الإلكتروني" />
                            <TextBox x:Name="CompanyEmailTextBox" Grid.Row="5" Margin="0,6,10,10" Style="{StaticResource AppTextBoxStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="الموقع الإلكتروني" />
                            <TextBox x:Name="CompanyWebsiteTextBox" Grid.Row="5" Grid.Column="1" Margin="0,6,0,10" Style="{StaticResource AppTextBoxStyle}" />
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettingsButton_Click">حفظ الإعدادات</Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="OpenConnectionSettingsButton_Click">إعدادات قاعدة البيانات</Button>
                            <Button Style="{StaticResource SoftButtonStyle}" Click="RefreshNotificationsButton_Click">تحديث الإشعارات</Button>
                        </WrapPanel>

                        <GroupBox Grid.Row="1" Header="الإشعارات الحالية">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <TextBlock x:Name="DatabaseSettingsSummaryTextBlock"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <ListBox Grid.Row="1"
                                         x:Name="NotificationsListBox"
                                         Style="{StaticResource InfoListBoxStyle}"
                                         ItemContainerStyle="{StaticResource InfoListBoxItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Margin="0,6,0,0" Text="{Binding Message}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
