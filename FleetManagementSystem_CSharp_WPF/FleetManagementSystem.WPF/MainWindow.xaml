<Window x:Class="FleetManagementSystem.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FleetManagementSystem.WPF.Converters"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="شركة جوميكس للحركة والمعدات"
        Width="1500"
        Height="920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.Name="نافذة شركة جوميكس للحركة والمعدات"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <converters:VisibleRowNumberConverter x:Key="VisibleRowNumberConverter"/>
        <x:Array x:Key="DriverAttendanceStatuses"
                 Type="{x:Type sys:String}">
            <sys:String>حاضر</sys:String>
            <sys:String>غائب</sys:String>
            <sys:String>إجازة</sys:String>
            <sys:String>راحة</sys:String>
        </x:Array>
        <Style x:Key="BaseButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="MinWidth"
                    Value="112"/>
            <Setter Property="Margin"
                    Value="0,0,10,10"/>
            <Setter Property="Padding"
                    Value="18,8"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}"/>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource AccentPaleBrush}"/>
            <Setter Property="BorderBrush"
                    Value="#C9DAE4"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground"
                    Value="{StaticResource DangerBrush}"/>
            <Setter Property="Background"
                    Value="#FFF5F7"/>
            <Setter Property="BorderBrush"
                    Value="#F0C4CB"/>
        </Style>

        <Style x:Key="SoftButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}"/>

        <Style x:Key="FilterTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Padding"
                    Value="24,2,9,2"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Background"
                    Value="#FBFDFE"/>
            <Setter Property="BorderBrush"
                    Value="#D6E4EC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Margin"
                    Value="4,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FilterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path Width="12"
                                      Height="12"
                                      Margin="8,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="M10.5,10.5 L14,14 M6.5,11 A4.5,4.5 0 1 1 6.5,2 A4.5,4.5 0 0 1 6.5,11"
                                      FlowDirection="LeftToRight"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource MutedBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="FilterBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="FilterBorder"
                                        Property="Background"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="FilterBorder"
                                        Property="BorderBrush"
                                        Value="#B9CEDA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Background"
                    Value="#FBFDFE"/>
            <Setter Property="BorderBrush"
                    Value="#D6E4EC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Border x:Name="DateTextBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="DateTextBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="DateTextBorder"
                                        Property="Background"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="DateTextBorder"
                                        Property="BorderBrush"
                                        Value="#B9CEDA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterDatePickerStyle"
               TargetType="DatePicker">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="MinWidth"
                    Value="134"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Language"
                    Value="ar-EG"/>
            <Setter Property="Background"
                    Value="#FBFDFE"/>
            <Setter Property="BorderBrush"
                    Value="#D6E4EC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Margin"
                    Value="4,0"/>
            <Setter Property="Padding"
                    Value="8,2"/>
        </Style>

        <Style x:Key="DriverAttendanceDayCellBorderStyle"
               TargetType="Border">
            <Setter Property="Margin"
                    Value="5,4"/>
            <Setter Property="Padding"
                    Value="8"/>
            <Setter Property="Background"
                    Value="#F8FBFC"/>
            <Setter Property="BorderBrush"
                    Value="#D7E5EC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="8"/>
        </Style>

        <Style x:Key="DriverAttendanceStatusComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="MinHeight"
                    Value="30"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
