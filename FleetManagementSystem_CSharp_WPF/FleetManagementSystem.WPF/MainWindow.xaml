                                          SelectedCellsChanged="DriversGrid_SelectedCellsChanged"
                                          AutoGenerateColumns="False"
                                          FrozenColumnCount="1"
                                          HeadersVisibility="Column"
                                          MinRowHeight="38"
                                          ColumnHeaderHeight="75">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="58"
                                                                IsReadOnly="True">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="تعديل"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GridRowActionButtonStyle}"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource GridEditActionIconTemplate}"
                                                            ToolTip="تعديل بيانات السائق"
                                                            AutomationProperties.Name="تعديل بيانات السائق"
                                                            Click="EditDriverButton_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="220">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="اسم السائق"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterName"
                                                             AutomationProperties.AutomationId="DriverFilterName"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding NationalId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="170">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="رقم قومي"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterNationalId"
                                                             AutomationProperties.AutomationId="DriverFilterNationalId"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding LicenseNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="150">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="رقم الرخصة"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterLicense"
                                                             AutomationProperties.AutomationId="DriverFilterLicense"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding LicenseType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="145">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="نوع الرخصة"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterLicenseType"
                                                             AutomationProperties.AutomationId="DriverFilterLicenseType"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="150">
                                            <DataGridTemplateColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="بداية الرخصة"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <DatePicker x:Name="DriverFilterLicenseStartDate"
                                                                AutomationProperties.AutomationId="DriverFilterLicenseStartDate"
                                                                HorizontalAlignment="Stretch"
                                                                Language="ar-EG"
                                                                Style="{StaticResource FilterDatePickerStyle}"
                                                                SelectedDateChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LicenseStartDate, StringFormat=yyyy-MM-dd}"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding LicenseStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Language="ar-EG"
                                                                Style="{StaticResource FilterDatePickerStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="150">
                                            <DataGridTemplateColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="نهاية الرخصة"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <DatePicker x:Name="DriverFilterLicenseExpiryDate"
                                                                AutomationProperties.AutomationId="DriverFilterLicenseExpiryDate"
                                                                HorizontalAlignment="Stretch"
                                                                Language="ar-EG"
                                                                Style="{StaticResource FilterDatePickerStyle}"
                                                                SelectedDateChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LicenseExpiryDate, StringFormat=yyyy-MM-dd}"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding LicenseExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Language="ar-EG"
                                                                Style="{StaticResource FilterDatePickerStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Binding="{Binding IsCompanyInsured, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="120">
                                            <DataGridCheckBoxColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="متأمن عليه"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterInsurance"
                                                             AutomationProperties.AutomationId="DriverFilterInsurance"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridCheckBoxColumn.Header>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTextColumn Binding="{Binding Governorate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="140">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="المحافظة"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterGovernorate"
                                                             AutomationProperties.AutomationId="DriverFilterGovernorate"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding FullAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="240">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="العنوان بالكامل"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterFullAddress"
                                                             AutomationProperties.AutomationId="DriverFilterFullAddress"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding TrafficUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="160">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="وحدة المرور"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterTrafficUnit"
                                                             AutomationProperties.AutomationId="DriverFilterTrafficUnit"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding WorkLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="160">
                                            <DataGridTextColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="موقع العمل"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterWorkLocation"
                                                             AutomationProperties.AutomationId="DriverFilterWorkLocation"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridCheckBoxColumn Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="95">
                                            <DataGridCheckBoxColumn.Header>
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Stretch">
                                                    <TextBlock Text="مفعل"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBox x:Name="DriverFilterActive"
                                                             AutomationProperties.AutomationId="DriverFilterActive"
                                                             HorizontalAlignment="Stretch"
                                                             Style="{StaticResource FilterTextBoxStyle}"
                                                             TextChanged="DriverFilter_Changed"/>
                                                </StackPanel>
                                            </DataGridCheckBoxColumn.Header>
                                        </DataGridCheckBoxColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="حضور وغياب">
                            <ScrollViewer x:Name="AttendanceTabScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid MinHeight="860">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"
                                                   MinHeight="220"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"
                                                   MinHeight="240"/>
                                    <RowDefinition Height="0"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource TripPageCardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PageTitleStyle}"
                                                       Text="تسجيل حضور اليوم"/>
                                            <TextBlock x:Name="DailyAttendanceDateTextBlock"
                                                       Margin="0,4,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    AutomationProperties.AutomationId="SaveDailyAttendanceButton"
                                                    Click="SaveDailyAttendanceButton_Click">حفظ الحضور</Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <DataGrid x:Name="DailyAttendanceGrid"
                                          Grid.Row="1"
                                          AutomationProperties.AutomationId="DailyAttendanceGrid"
                                          AutoGenerateColumns="False"
                                          FrozenColumnCount="1"
                                          HeadersVisibility="Column"
                                          MinRowHeight="44"
                                          RowHeight="44"
                                          GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding DriverName}"
                                                            Width="220"
                                                            IsReadOnly="True">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="اسم السائق"
                                                           FontWeight="Bold"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding WorkLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="180">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="موقع العمل"
                                                           FontWeight="Bold"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="150">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="الحالة"
                                                           FontWeight="Bold"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Margin"
                                                                        Value="5,4"/>
                                                                <Setter Property="Padding"
                                                                        Value="4"/>
                                                                <Setter Property="Background"
                                                                        Value="#F8FBFC"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#D7E5EC"/>
                                                                <Setter Property="BorderThickness"
                                                                        Value="1"/>
                                                                <Setter Property="CornerRadius"
                                                                        Value="8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="حاضر">
                                                                        <Setter Property="Background"
                                                                                Value="#E8F5E9"/>
                                                                        <Setter Property="BorderBrush"
                                                                                Value="#81C784"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="غائب">
                                                                        <Setter Property="Background"
                                                                                Value="#FFEBEE"/>
                                                                        <Setter Property="BorderBrush"
                                                                                Value="#EF9A9A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="إجازة">
                                                                        <Setter Property="Background"
                                                                                Value="#FFF8E1"/>
                                                                        <Setter Property="BorderBrush"
                                                                                Value="#FFD54F"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="راحة">
                                                                        <Setter Property="Background"
                                                                                Value="#ECEFF1"/>
                                                                        <Setter Property="BorderBrush"
                                                                                Value="#B0BEC5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ComboBox ItemsSource="{StaticResource DriverAttendanceStatuses}"
                                                                  SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectionChanged="DailyAttendanceInput_Changed"
                                                                  Style="{StaticResource DriverAttendanceStatusComboBoxStyle}"
                                                                  ToolTip="حالة الحضور"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="سبب الغياب"
                                                           FontWeight="Bold"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Margin"
                                                                        Value="6,5"/>
                                                                <Setter Property="Background"
                                                                        Value="#FBFDFE"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#D6E4EC"/>
                                                                <Setter Property="BorderThickness"
                                                                        Value="1"/>
                                                                <Setter Property="CornerRadius"
                                                                        Value="6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAbsent}"
                                                                                 Value="False">
                                                                        <Setter Property="Opacity"
                                                                                Value="0.2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBox Text="{Binding AbsenceReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsAbsent}"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Padding="10,6"
                                                                 FontSize="13"
                                                                 Foreground="#1F2D3A"
                                                                 VerticalContentAlignment="Center"
                                                                 TextChanged="DailyAttendanceInput_Changed"
                                                                 ToolTip="اكتب سبب الغياب"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2"
                                        Background="{StaticResource BorderBrush}"
                                        Height="1"
                                        Margin="0,4"/>
                                <Border Grid.Row="3"
                                        Style="{StaticResource TripPageCardStyle}"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PageTitleStyle}"
                                                       Text="سجل غيابات السائق"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   VerticalAlignment="Center">
                                            <StackPanel Width="220"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="السائق"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox x:Name="AbsenceHistoryDriverComboBox"
                                                          Height="42"
                                                          DisplayMemberPath="FullName"
                                                          SelectedValuePath="Id"
                                                          Style="{StaticResource AppComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Width="140"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="من"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,0,0,4"/>
                                                <DatePicker x:Name="AbsenceHistoryFromPicker"
                                                            Height="42"
                                                            Language="ar-EG"
                                                            Style="{StaticResource FilterDatePickerStyle}"/>
                                            </StackPanel>
                                            <StackPanel Width="140"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="إلى"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,0,0,4"/>
                                                <DatePicker x:Name="AbsenceHistoryToPicker"
                                                            Height="42"
                                                            Language="ar-EG"
                                                            Style="{StaticResource FilterDatePickerStyle}"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="LoadAbsenceHistoryButton_Click">عرض الغيابات</Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <DataGrid x:Name="AbsenceHistoryGrid"
                                          Grid.Row="4"
                                          AutomationProperties.AutomationId="AbsenceHistoryGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          FrozenColumnCount="1"
                                          HeadersVisibility="Column"
                                          MinRowHeight="44"
                                          RowHeight="44"
                                          GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding WorkDate, StringFormat='yyyy-MM-dd'}"
                                                            Width="140"
                                                            IsReadOnly="True">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="التاريخ"
                                                           FontWeight="Bold"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding DayName}"
                                                            Width="100"
                                                            IsReadOnly="True">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="اليوم"
                                                           FontWeight="Bold"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="130">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="الحالة"
                                                           FontWeight="Bold"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Margin="5,4"
                                                            Padding="8,4"
                                                            CornerRadius="6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="#FFEBEE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="إجازة">
                                                                        <Setter Property="Background"
                                                                                Value="#FFF8E1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#C62828"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding AbsenceReason}"
                                                            Width="*"
                                                            IsReadOnly="True">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="السبب"
                                                           FontWeight="Bold"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="DriverAttendanceGrid"
                                          Grid.Row="5"
                                          Visibility="Collapsed"
                                          AutomationProperties.AutomationId="DriverAttendanceGrid"
