<Window x:Class="FleetManagementSystem.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة الأسطول"
        Width="1500"
        Height="920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="SoftButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentPaleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPaleBrush}" />
        </Style>

        <Style x:Key="DocumentIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="Data" Value="M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z M14,2 V8 H20 M16,13 H8 M16,17 H8 M10,9 H8" />
        </Style>

        <Style x:Key="CheckIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
            <Setter Property="StrokeThickness" Value="2.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="Data" Value="M20,6 L9,17 L4,12" />
        </Style>

        <DataTemplate x:Key="DocumentColumnHeaderTemplate">
            <Viewbox Width="20"
                     Height="20"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True"
                     ToolTip="مستند">
                <Path Style="{StaticResource DocumentIconPathStyle}" />
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="DocumentButtonIconTemplate">
            <Viewbox Width="19"
                     Height="19"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Style="{StaticResource DocumentIconPathStyle}"
                      Stroke="White" />
            </Viewbox>
        </DataTemplate>

        <Style x:Key="GridDocumentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Content" Value="مستند" />
            <Setter Property="ContentTemplate" Value="{StaticResource DocumentButtonIconTemplate}" />
        </Style>

        <Style x:Key="SurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.08"
                                      Color="#22000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <Style x:Key="DashboardNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="235" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F7FA" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EAF2F7" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TripPageCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
            <Setter Property="Background" Value="#F7FAF8" />
            <Setter Property="BorderBrush" Value="#D7E5DD" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="TripRoundActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#587A6C" />
            <Setter Property="BorderBrush" Value="#587A6C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="PageHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="InfoListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="InfoListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardAlertListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="AlertItemRoot"
                                Background="Transparent"
                                Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AlertItemRoot" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AlertItemRoot" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#EEF4F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <ContentPresenter Grid.Row="1" Margin="0,14,0,0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border x:Name="NavigationBarBorder"
                DockPanel.Dock="Top"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="18,16"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="NavigationBarTitleTextBlock"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="لوحة التحكم" />
                    <TextBlock x:Name="NavigationBarSubtitleTextBlock"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Text="تنقل بين صفحات النظام ثم ارجع إلى الرئيسية في أي وقت." />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center">
                    <Button Style="{StaticResource SoftButtonStyle}"
                            Click="GoToDashboardButton_Click">
                        الرئيسية
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenConnectionSettingsButton_Click">
                        إعدادات النظام
                    </Button>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Click="LogoutButton_Click">
                        تسجيل الخروج
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SurfaceCardStyle}"
                Margin="0,0,0,0"
                Padding="18">
            <TabControl x:Name="MainTabs"
                        Margin="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Style="{StaticResource HiddenTabControlStyle}"
                        SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="لوحة التحكم" Tag="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="12"
                          FlowDirection="LeftToRight">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,10,0,42"
                                    HorizontalAlignment="Center"
                                    FlowDirection="RightToLeft">
                            <Border Width="132"
                                    Height="132"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    Padding="12">
                                <Grid>
                                    <Image x:Name="CompanyLogoImage"
                                           Stretch="Uniform"
                                           Visibility="Collapsed" />
                                    <TextBlock x:Name="CompanyLogoPlaceholderTextBlock"
                                               Text="LOGO"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CompanyHeaderTextBlock"
                                       Margin="0,18,0,0"
                                       Text="نظام إدارة الأسطول"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="CurrentDateTimeTextBlock"
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="ConnectionInfoTextBlock"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SurfaceCardStyle}"
                                    Padding="26">
                                <StackPanel FlowDirection="RightToLeft"
                                            VerticalAlignment="Center">
                                    <Border Width="118"
                                            Height="118"
                                            Background="{StaticResource AccentPaleBrush}"
                                            CornerRadius="59"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="UserInitialsTextBlock"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="م" />
                                    </Border>
                                    <TextBlock Text="المستخدم الحالي"
                                               Margin="0,18,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CurrentUserTextBlock"
                                               Margin="0,10,0,0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,26,0,0"
                                            Click="LogoutButton_Click">
                                        تسجيل الخروج
                                    </Button>
                                    <Button x:Name="AdminAddUserButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,12,0,0"
                                            Click="DashboardAddUserButton_Click"
                                            Visibility="Collapsed">
                                        إضافة مستخدم جديد
                                    </Button>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        FlowDirection="RightToLeft">
                                <TextBlock Text="اختر القسم المطلوب"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="اختصارات سريعة للبدء من الصفحة الرئيسية حسب توزيع العمل المطلوب."
                                           Margin="0,8,0,0"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />

                                <UniformGrid Columns="2"
                                             Margin="0,26,0,0">
                                    <Button Style="{StaticResource DashboardNavButtonStyle}"
                                            Click="QuickOpenTripsButton_Click">
                                        التشغيلات
                                    </Button>
                                    <Button Style="{StaticResource DashboardNavButtonStyle}"
                                            Click="QuickOpenLicensesAndInsuranceButton_Click">
                                        التراخيص والتأمينات
                                    </Button>
                                    <Button Style="{StaticResource DashboardNavButtonStyle}"
                                            Click="QuickOpenCustodyButton_Click">
                                        العهد
                                    </Button>
                                    <Button Style="{StaticResource DashboardNavButtonStyle}"
                                            Click="QuickOpenTreasuryButton_Click">
                                        الخزينة
                                    </Button>
                                    <Button Style="{StaticResource DashboardNavButtonStyle}"
                                            Click="QuickOpenReportsButton_Click">
                                        التقارير
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,32,0,0"
                                Style="{StaticResource SurfaceCardStyle}"
                                Padding="22"
                                FlowDirection="RightToLeft">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="#F8FBFD"
                                        BorderBrush="#D9E5EC"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="إنذارات التجديد والمتابعة"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock x:Name="DashboardAlertSummaryTextBlock"
                                                       Margin="0,6,0,0"
                                                       FontSize="13"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource AccentPaleBrush}"
                                                BorderBrush="#C9DAE4"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,9"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="DashboardAlertCountTextBlock"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1"
                                      Margin="0,18,0,0">
                                    <Border x:Name="DashboardNoAlertsPanel"
                                            Background="#F7FAFC"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40"
                                                    Height="40"
                                                    Background="#EAF6EF"
                                                    CornerRadius="20"
                                                    Margin="0,0,12,0">
                                                <Viewbox Width="20"
                                                         Height="20"
                                                         FlowDirection="LeftToRight"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                    <Path Style="{StaticResource CheckIconPathStyle}" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="لا توجد إنذارات حالية"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="كل التراخيص والتأمينات المسجلة سليمة في نطاق المتابعة الحالي."
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ListBox x:Name="DashboardAlertsListBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             MaxHeight="320"
                                             ItemContainerStyle="{StaticResource DashboardAlertListBoxItemStyle}"
                                             Visibility="Collapsed"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Background="{Binding AccentBrush}" />

                                                        <Border Grid.Column="1"
                                                                Width="42"
                                                                Height="42"
                                                                Margin="14,14,0,14"
                                                                Background="{Binding ChipBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="21"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding CategoryInitial}"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="2"
                                                                    Margin="14"
                                                                    VerticalAlignment="Center">
                                                            <WrapPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="15"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding TextBrush}"
                                                                           TextWrapping="Wrap" />
                                                                <Border Background="{Binding ChipBrush}"
                                                                        BorderBrush="{Binding BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="9,4"
                                                                        Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding CategoryText}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="{Binding AccentBrush}" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding Message}"
                                                                       Margin="0,7,0,0"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="21" />
                                                            <TextBlock Text="{Binding DueDateText}"
                                                                       Margin="0,6,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3"
                                                                    Margin="14"
                                                                    MinWidth="118"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                            <Border Background="{Binding ChipBrush}"
                                                                    BorderBrush="{Binding BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    Padding="10,5"
                                                                    HorizontalAlignment="Stretch">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding AccentBrush}"
                                                                           HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TimingText}"
                                                                       Margin="0,8,0,0"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="TotalVehiclesTextBlock" />
                            <TextBlock x:Name="AvailableVehiclesTextBlock" />
                            <TextBlock x:Name="VehiclesInTripTextBlock" />
                            <TextBlock x:Name="OpenMaintenanceTextBlock" />
                            <TextBlock x:Name="ExpiringLicensesTextBlock" />
                            <TextBlock x:Name="OpenTripsTextBlock" />
                            <TextBlock x:Name="TripsTodayTextBlock" />
                            <TextBlock x:Name="OilDueTextBlock" />
                            <TextBlock x:Name="TreasuryBalanceTextBlock" />
                            <TextBlock x:Name="TotalExpensesTextBlock" />
                            <TextBlock x:Name="TotalFuelCostTextBlock" />
                            <TextBlock x:Name="ActiveContractsTextBlock" />
                            <ListBox x:Name="AlertsListBox" />
                            <ListBox x:Name="ActivityListBox" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

