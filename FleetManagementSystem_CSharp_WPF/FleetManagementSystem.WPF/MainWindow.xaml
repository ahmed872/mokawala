        </Style>

        <Style x:Key="WrappingCellTextStyle"
               TargetType="TextBlock">
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="DocumentIconPathStyle"
               TargetType="Path">
            <Setter Property="Width"
                    Value="24"/>
            <Setter Property="Height"
                    Value="24"/>
            <Setter Property="Stretch"
                    Value="Uniform"/>
            <Setter Property="Fill"
                    Value="Transparent"/>
            <Setter Property="Stroke"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="StrokeThickness"
                    Value="2.2"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="FlowDirection"
                    Value="LeftToRight"/>
            <Setter Property="Data"
                    Value="M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z M14,2 V8 H20 M16,13 H8 M16,17 H8 M10,9 H8"/>
        </Style>

        <Style x:Key="CheckIconPathStyle"
               TargetType="Path">
            <Setter Property="Width"
                    Value="24"/>
            <Setter Property="Height"
                    Value="24"/>
            <Setter Property="Stretch"
                    Value="Uniform"/>
            <Setter Property="Fill"
                    Value="Transparent"/>
            <Setter Property="Stroke"
                    Value="{StaticResource SuccessBrush}"/>
            <Setter Property="StrokeThickness"
                    Value="2.8"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="FlowDirection"
                    Value="LeftToRight"/>
            <Setter Property="Data"
                    Value="M20,6 L9,17 L4,12"/>
        </Style>

        <DataTemplate x:Key="DocumentColumnHeaderTemplate">
            <Viewbox Width="20"
                     Height="20"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True"
                     ToolTip="مستند">
                <Path Style="{StaticResource DocumentIconPathStyle}"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="DocumentButtonIconTemplate">
            <Viewbox Width="19"
                     Height="19"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Style="{StaticResource DocumentIconPathStyle}"
                      Stroke="White"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="GridDocumentActionIconTemplate">
            <Viewbox Width="18"
                     Height="18"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Style="{StaticResource DocumentIconPathStyle}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="GridEditActionIconTemplate">
            <Viewbox Width="18"
                     Height="18"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Data="M12,20 H21 M16.5,3.5 A2.1,2.1 0 0 1 19.5,6.5 L8,18 L3,19.5 L4.5,14.5 L16.5,3.5 Z"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="GridDeleteActionIconTemplate">
            <Viewbox Width="18"
                     Height="18"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Data="M3,6 H21 M8,6 V4 H16 V6 M6,6 L7,21 H17 L18,6 M10,10 V17 M14,10 V17"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="GridPrintActionIconTemplate">
            <Viewbox Width="18"
                     Height="18"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Data="M7,8 V3 H17 V8 M7,17 H5 A2,2 0 0 1 3,15 V10 A2,2 0 0 1 5,8 H19 A2,2 0 0 1 21,10 V15 A2,2 0 0 1 19,17 H17 M7,14 H17 V21 H7 Z M17,12 H17.01"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="GridClearLicenseActionIconTemplate">
            <Viewbox Width="18"
                     Height="18"
                     FlowDirection="LeftToRight"
                     SnapsToDevicePixels="True">
                <Path Data="M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 L15,19 M15,13 L9,19"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="GridRowActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width"
                    Value="34"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="MinWidth"
                    Value="34"/>
            <Setter Property="Margin"
                    Value="2,0"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background"
                    Value="#F7FBFD"/>
            <Setter Property="BorderBrush"
                    Value="#D3E2EA"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="GridRowDangerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GridRowActionButtonStyle}">
            <Setter Property="Foreground"
                    Value="{StaticResource DangerBrush}"/>
            <Setter Property="Background"
                    Value="#FFF7F8"/>
            <Setter Property="BorderBrush"
                    Value="#F0C4CB"/>
        </Style>

        <Style x:Key="ReportToolbarIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GridRowActionButtonStyle}">
            <Setter Property="Width"
                    Value="42"/>
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="MinWidth"
                    Value="42"/>
            <Setter Property="Margin"
                    Value="6,0,0,0"/>
        </Style>

        <Style x:Key="ReportToolbarDangerIconButtonStyle"
