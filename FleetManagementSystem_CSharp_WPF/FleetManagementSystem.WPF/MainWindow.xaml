                <TabItem Header="السائقون"
                         Tag="Drivers">
                    <TabControl Style="{StaticResource DriverModuleTabControlStyle}"
                                ItemContainerStyle="{StaticResource DriverModuleTabItemStyle}"
                                SelectedIndex="0">
                        <TabItem Header="تسجيل السائقين">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Style="{StaticResource TripPageCardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PageTitleStyle}"
                                                       Text="السائقين"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   VerticalAlignment="Center">
                                            <Button Style="{StaticResource TripRoundActionButtonStyle}"
                                                    ToolTip="إضافة سائق"
                                                    Click="AddDriverButton_Click">+</Button>
                                            <Button Style="{StaticResource DangerButtonStyle}"
                                                    Margin="10,0,0,0"
                                                    Click="DeleteDriverButton_Click">حذف</Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
