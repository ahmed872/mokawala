                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Vertical"
                                                    HorizontalAlignment="Stretch">
                                            <TextBlock Text="ملاحظات"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,8"/>
                                            <TextBox x:Name="CustodyFilterNotes"
                                                     AutomationProperties.AutomationId="CustodyFilterNotes"
                                                     HorizontalAlignment="Stretch"
                                                     Style="{StaticResource FilterTextBoxStyle}"
                                                     TextChanged="CustodyFilter_Changed"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem x:Name="MyCustodyTab"
                         Header="عهدتي"
                         Tag="MyCustody">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Style="{StaticResource TripPageCardStyle}"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitleStyle}"
                                               Text="عهدتي"/>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="العهد المسجلة باسمك: تابع قيمتها والمتبقي عليها وقم بتصفيتها من هنا."/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="تحديث عهدتي"
                                        Click="RefreshMyCustodyButton_Click">تحديث</Button>
                            </Grid>
                        </Border>

                        <!-- ملخص عهدتي -->
                        <Border DockPanel.Dock="Top"
                                Background="#F0FFF4"
                                BorderBrush="#C5DBC8"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,12"
                                Margin="0,0,0,10">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="إجمالي قيمة عهدي"
                                               FontSize="12"
                                               Foreground="#607D8B"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="MyCustodyTotalTextBlock"
                                               Text="0"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#C5DBC8"
                                        Width="1"
                                        Margin="0,4"/>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="تم تسديده"
                                               FontSize="12"
                                               Foreground="#607D8B"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="MyCustodySettledTextBlock"
                                               Text="0"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="3"
                                        Background="#C5DBC8"
                                        Width="1"
                                        Margin="0,4"/>
                                <StackPanel Grid.Column="4"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="المتبقي عليّ"
                                               FontSize="12"
                                               Foreground="#607D8B"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="MyCustodyRemainingTextBlock"
                                               Text="0"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#E65100"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="MyCustodyEmptyBorder"
                                DockPanel.Dock="Top"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <TextBlock Text="لا توجد عهد مسجلة باسمك حتى الآن."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <DataGrid x:Name="MyCustodyGrid"
                                  AutomationProperties.AutomationId="MyCustodyGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinRowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="إجراءات"
                                                        Width="110"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="تصفية العهدة"
                                                    AutomationProperties.Name="تصفية عهدتي"
                                                    Click="SettleMyCustodyButton_Click">تصفية</Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="رقم العهدة"
                                                    Binding="{Binding CustodyNumber}"
                                                    Width="170"/>
                                <DataGridTextColumn Header="قيمة العهدة"
                                                    Binding="{Binding Amount, StringFormat=N2}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="تم تسديده"
                                                    Binding="{Binding SettledAmount, StringFormat=N2}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="المتبقي"
                                                    Binding="{Binding RemainingAmount, StringFormat=N2}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="الحالة"
                                                    Binding="{Binding Status}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="العربية"
                                                    Binding="{Binding VehiclePlateNumber}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="تاريخ التسليم"
                                                    Binding="{Binding HandoverDate, StringFormat=yyyy-MM-dd}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="ملاحظات"
                                                    Binding="{Binding Notes}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="البيانات الأساسية"
                         Tag="MasterData">
                    <TabControl>
                        <TabItem Header="أنواع المركبات">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddVehicleTypeButton_Click">إضافة</Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveVehicleTypeButton_Click">حفظ المحدد</Button>
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteVehicleTypeButton_Click">حذف المحدد</Button>
                                </WrapPanel>
                                <DataGrid x:Name="VehicleTypesGrid"
                                          AutomationProperties.AutomationId="VehicleTypesGrid"
                                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="حالات العقود">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddContractStatusButton_Click">إضافة</Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveContractStatusButton_Click">حفظ المحدد</Button>
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteContractStatusButton_Click">حذف المحدد</Button>
                                </WrapPanel>
                                <DataGrid x:Name="ContractStatusesGrid"
                                          AutomationProperties.AutomationId="ContractStatusesGrid"
                                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="أنواع الصيانة">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddMaintenanceTypeButton_Click">إضافة</Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveMaintenanceTypeButton_Click">حفظ المحدد</Button>
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteMaintenanceTypeButton_Click">حذف المحدد</Button>
                                </WrapPanel>
                                <DataGrid x:Name="MaintenanceTypesGrid"
                                          AutomationProperties.AutomationId="MaintenanceTypesGrid"
                                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="مزودو الخدمة">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddServiceProviderButton_Click">إضافة</Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveServiceProviderButton_Click">حفظ المحدد</Button>
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteServiceProviderButton_Click">حذف المحدد</Button>
                                </WrapPanel>
                                <DataGrid x:Name="ServiceProvidersGrid"
                                          AutomationProperties.AutomationId="ServiceProvidersGrid"
                                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="التقارير"
                         Tag="Reports">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource SurfaceCardStyle}"
                                Padding="18"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0"
                                           VerticalAlignment="Center">
                                    <StackPanel Width="260"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="نوع التقرير"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ReportTypeComboBox"
                                                  AutomationProperties.AutomationId="ReportTypeComboBox"
                                                  Height="42"
                                                  Style="{StaticResource AppComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ReportTypeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="المركبات"
                                                          Tag="vehicles"/>
                                            <ComboBoxItem Content="جميع التشغيلات"
                                                          Tag="alltrips"/>
                                            <ComboBoxItem Content="تراخيص العربيات"
                                                          Tag="vehiclelicenses"/>
                                            <ComboBoxItem Content="التأمينات"
                                                          Tag="insurance"/>
                                            <ComboBoxItem Content="الزيوت"
                                                          Tag="oilchanges"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel x:Name="ReportVehicleFilterPanel"
                                                Width="220"
                                                Margin="0,0,12,0"
                                                Visibility="Collapsed">
                                        <TextBlock Text="العربية"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ReportVehicleComboBox"
                                                      AutomationProperties.AutomationId="ReportVehicleComboBox"
                                                      Height="42"
                                                      Style="{StaticResource AppComboBoxStyle}"
                                                      DisplayMemberPath="PlateNumber"
                                                      SelectedValuePath="Id"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource GridRowActionButtonStyle}"
                                                    Margin="6,0,0,0"
                                                    Content="×"
                                                    FontSize="18"
                                                    ToolTip="كل العربيات"
                                                    AutomationProperties.Name="كل العربيات"
                                                    Click="ClearReportVehicleFilterButton_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="ReportStartDatePanel"
                                                Width="155"
                                                Margin="0,0,12,0">
                                        <TextBlock x:Name="ReportStartDateLabel"
                                                   Text="من"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,6"/>
                                        <DatePicker x:Name="ReportStartDatePicker"
                                                    Style="{StaticResource FilterDatePickerStyle}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="ReportEndDatePanel"
                                                Width="155"
                                                Margin="0,0,12,0">
                                        <TextBlock x:Name="ReportEndDateLabel"
                                                   Text="إلى"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,6"/>
                                        <DatePicker x:Name="ReportEndDatePicker"
                                                    Style="{StaticResource FilterDatePickerStyle}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            FlowDirection="LeftToRight">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            AutomationProperties.AutomationId="GenerateReportButton"
                                            Click="GenerateReportButton_Click">توليد التقرير</Button>
                                    <Button Style="{StaticResource ReportToolbarIconButtonStyle}"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource GridDocumentActionIconTemplate}"
                                            ToolTip="طباعة كل التقرير المعروض"
                                            AutomationProperties.Name="طباعة كل التقرير المعروض"
                                            Click="ShowReportA5Button_Click"/>
                                    <Button Style="{StaticResource ReportToolbarDangerIconButtonStyle}"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource GridDeleteActionIconTemplate}"
                                            ToolTip="حذف التقرير"
                                            AutomationProperties.Name="حذف التقرير"
                                            Click="DeleteReportButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="ReportsGrid"
                                  AutomationProperties.AutomationId="ReportsGrid"
                                  Grid.Row="1"
                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                                  AutoGenerateColumns="True"
                                  ColumnWidth="190"
                                  FrozenColumnCount="1"
                                  HeadersVisibility="Column"
                                  MinRowHeight="38"
                                  ColumnHeaderHeight="75"
                                  IsReadOnly="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="إجراءات"
                                                        Width="92"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        FlowDirection="LeftToRight">
                                                <Button Style="{StaticResource GridRowActionButtonStyle}"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource GridDocumentActionIconTemplate}"
                                                        ToolTip="طباعة هذا السجل فقط"
                                                        AutomationProperties.Name="طباعة هذا السجل فقط"
                                                        Click="ShowReportRowA5Button_Click"/>
                                                <Button Style="{StaticResource GridRowDangerActionButtonStyle}"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource GridDeleteActionIconTemplate}"
                                                        ToolTip="حذف السجل من التقرير"
                                                        AutomationProperties.Name="حذف السجل من التقرير"
                                                        Click="DeleteReportButton_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="المستخدمون والصلاحيات"
                         Tag="Users">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="AddUserButton"
                                    Click="AddUserButton_Click">إضافة مستخدم</Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Click="RefreshUsersButton_Click">تحديث</Button>
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Click="ToggleUserStatusButton_Click">تفعيل/إيقاف</Button>
                        </WrapPanel>
                        <DataGrid x:Name="UsersGrid"
                                  AutomationProperties.AutomationId="UsersGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinRowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="إجراءات"
                                                        Width="70"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GridRowActionButtonStyle}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource GridEditActionIconTemplate}"
                                                    ToolTip="تعديل المستخدم"
                                                    AutomationProperties.Name="تعديل المستخدم"
                                                    Click="EditUserButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="اسم المستخدم"
                                                    Binding="{Binding Username}"
                                                    Width="190"/>
                                <DataGridTextColumn Header="الاسم الكامل"
                                                    Binding="{Binding FullName}"
                                                    Width="220"/>
                                <DataGridTextColumn Header="البريد الإلكتروني"
                                                    Binding="{Binding Email}"
                                                    Width="*"
                                                    MinWidth="180"/>
                                <DataGridTextColumn Header="الدور"
                                                    Binding="{Binding RoleDisplay}"
                                                    Width="190"/>
                                <DataGridTextColumn Header="الحالة"
                                                    Binding="{Binding StatusDisplay}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="آخر دخول"
                                                    Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}"
                                                    Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="الإعدادات"
                         Tag="Settings">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="بيانات الشركة">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="اسم الشركة"/>
                                <TextBox x:Name="CompanyNameTextBox"
                                         Grid.Row="1"
                                         Margin="0,6,10,10"
                                         Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="الاسم الإنجليزي"/>
                                <TextBox x:Name="CompanyNameEnTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,6,0,10"
                                         Style="{StaticResource AppTextBoxStyle}"/>

                                <TextBlock Grid.Row="2"
                                           Text="العنوان"/>
                                <TextBox x:Name="CompanyAddressTextBox"
                                         Grid.Row="3"
                                         Margin="0,6,10,10"
                                         Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="الهاتف"/>
                                <TextBox x:Name="CompanyPhoneTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,6,0,10"
                                         Style="{StaticResource AppTextBoxStyle}"/>

                                <TextBlock Grid.Row="4"
                                           Text="البريد الإلكتروني"/>
                                <TextBox x:Name="CompanyEmailTextBox"
                                         Grid.Row="5"
                                         Margin="0,6,10,10"
                                         Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="الموقع الإلكتروني"/>
                                <TextBox x:Name="CompanyWebsiteTextBox"
                                         Grid.Row="5"
                                         Grid.Column="1"
                                         Margin="0,6,0,10"
                                         Style="{StaticResource AppTextBoxStyle}"/>
                            </Grid>
                        </GroupBox>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Margin="0,0,0,12">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveSettingsButton_Click">حفظ الإعدادات</Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OpenConnectionSettingsButton_Click">إعدادات قاعدة البيانات</Button>
                                <Button Style="{StaticResource SoftButtonStyle}"
                                        Click="RefreshNotificationsButton_Click">تحديث الإشعارات</Button>
                            </WrapPanel>

                            <GroupBox Grid.Row="1"
                                      Header="الإشعارات الحالية">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <TextBlock x:Name="DatabaseSettingsSummaryTextBlock"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             x:Name="NotificationsListBox"
                                             Style="{StaticResource InfoListBoxStyle}"
                                             ItemContainerStyle="{StaticResource InfoListBoxItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{Binding Message}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
