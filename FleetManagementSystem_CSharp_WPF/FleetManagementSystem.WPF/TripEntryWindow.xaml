<Window x:Class="FleetManagementSystem.WPF.TripEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة تشغيل جديد"
        Width="980"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="TripEntryWindow"
        AutomationProperties.Name="نافذة إضافة تشغيل جديد"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="TripPopupSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TripPopupAltBrush" Color="#F7FAFC" />
        <SolidColorBrush x:Key="TripPopupAccentBrush" Color="#123B53" />
        <SolidColorBrush x:Key="TripPopupAccentSoftBrush" Color="#2A607D" />
        <SolidColorBrush x:Key="TripPopupAccentPaleBrush" Color="#EAF2F7" />
        <SolidColorBrush x:Key="TripPopupTextBrush" Color="#1F2D3A" />
        <SolidColorBrush x:Key="TripPopupMutedBrush" Color="#6B7A88" />
        <SolidColorBrush x:Key="TripPopupBorderBrush" Color="#D7E0E8" />

        <Style x:Key="TripPopupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TripPopupSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TripPopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="TripPopupLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TripPopupMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="TripPopupValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TripPopupTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TripSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TripPopupTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="TripInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource TripPopupAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TripPopupBorderBrush}" />
        </Style>

        <Style x:Key="TripInputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource TripPopupAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TripPopupBorderBrush}" />
        </Style>

        <Style x:Key="TripInputDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TripPopupTextBrush}" />
            <Setter Property="Background" Value="{StaticResource TripPopupAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TripPopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TripSummaryCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TripPopupAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TripPopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="TripPopupPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="136" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TripPopupAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TripPopupAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TripPopupAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TripPopupSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TripPopupPrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TripPopupAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource TripPopupAccentPaleBrush}" />
            <Setter Property="BorderBrush" Value="#C9DAE4" />
        </Style>

        <Style x:Key="TripSmallCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource TripPopupSecondaryButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TripPopupSurfaceBrush}"
                BorderBrush="{StaticResource TripPopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="إضافة تشغيل جديد"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TripPopupTextBrush}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TripPopupMutedBrush}"
                               Text="التشغيلات" />
                </StackPanel>

                <Border Grid.Column="1"
                        Height="36"
                        MinWidth="98"
                        VerticalAlignment="Center"
                        Background="{StaticResource TripPopupAccentPaleBrush}"
                        BorderBrush="#C9DAE4"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16,0">
                    <TextBlock Text="تشغيلة"
                               Foreground="{StaticResource TripPopupAccentBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,14"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource TripPopupCardStyle}"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="بيانات التشغيل"
                                   Style="{StaticResource TripSectionTitleStyle}" />

                        <StackPanel Grid.Row="1"
                                    Margin="0,0,10,14">
                            <TextBlock Text="رقم السيارة" Style="{StaticResource TripPopupLabelStyle}" />
                            <ComboBox x:Name="VehicleComboBox"
                                      AutomationProperties.AutomationId="TripVehicleComboBox"
                                      AutomationProperties.Name="رقم السيارة"
                                      Style="{StaticResource TripInputComboBoxStyle}"
                                      DisplayMemberPath="PlateNumber"
                                      SelectedValuePath="Id"
                                      SelectionChanged="VehicleComboBox_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10,0,0,14">
                            <TextBlock Text="التاريخ والوقت" Style="{StaticResource TripPopupLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="TripDatePicker"
                                            AutomationProperties.AutomationId="TripDatePicker"
                                            AutomationProperties.Name="تاريخ التشغيلة"
                                            Style="{StaticResource TripInputDatePickerStyle}"
                                            SelectedDateFormat="Short" />
                                <TextBox x:Name="TripTimeTextBox"
                                         Grid.Column="1"
                                         AutomationProperties.AutomationId="TripTimeTextBox"
                                         AutomationProperties.Name="وقت التشغيلة"
                                         Margin="8,0,0,0"
                                         Style="{StaticResource TripInputTextBoxStyle}"
                                         ToolTip="الوقت بصيغة 24 ساعة مثل 14:30" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Margin="0,0,10,14">
                            <TextBlock Text="اسم السائق" Style="{StaticResource TripPopupLabelStyle}" />
                            <ComboBox x:Name="DriverComboBox"
                                      AutomationProperties.AutomationId="TripDriverComboBox"
                                      AutomationProperties.Name="اسم السائق"
                                      Style="{StaticResource TripInputComboBoxStyle}"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="10,0,0,14">
                            <TextBlock Text="طالب التشغيل (الموصي)" Style="{StaticResource TripPopupLabelStyle}" />
                            <TextBox x:Name="RequesterNameTextBox"
                                     AutomationProperties.AutomationId="TripRequesterNameTextBox"
                                     AutomationProperties.Name="طالب التشغيل"
                                     Style="{StaticResource TripInputTextBoxStyle}"
                                     ToolTip="اكتب اسم طالب التشغيل" />
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Margin="0,0,10,14">
                            <TextBlock Text="المعني بالدرج (المشرف)" Style="{StaticResource TripPopupLabelStyle}" />
                            <ComboBox x:Name="SupervisorComboBox"
                                      AutomationProperties.AutomationId="TripSupervisorComboBox"
                                      AutomationProperties.Name="المشرف"
                                      Style="{StaticResource TripInputComboBoxStyle}"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id" />
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="10,0,0,14">
                            <TextBlock Text="الغرض" Style="{StaticResource TripPopupLabelStyle}" />
                            <TextBox x:Name="PurposeTextBox"
                                     AutomationProperties.AutomationId="TripPurposeTextBox"
                                     AutomationProperties.Name="الغرض"
                                     Style="{StaticResource TripInputTextBoxStyle}" />
                        </StackPanel>

                        <Border Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,2,0,16"
                                Background="{StaticResource TripPopupBorderBrush}" />

                        <Grid Grid.Row="5"
                              Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.ColumnSpan="2"
                                       Text="مسار التشغيل"
                                       Style="{StaticResource TripSectionTitleStyle}"
                                       Margin="0,0,0,14" />

                            <StackPanel Grid.Row="1"
                                        Margin="0,0,10,0">
                                <TextBlock Text="منطقة التحرك" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBox x:Name="StartLocationTextBox"
                                         AutomationProperties.AutomationId="TripStartLocationTextBox"
                                         AutomationProperties.Name="منطقة التحرك"
                                         Style="{StaticResource TripInputTextBoxStyle}"
                                         ToolTip="اكتب منطقة التحرك" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="10,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="مناطق الوصول" Style="{StaticResource TripPopupLabelStyle}" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TripSmallCommandButtonStyle}"
                                            AutomationProperties.AutomationId="AddTripDestinationButton"
                                            AutomationProperties.Name="إضافة نقطة وصول"
                                            Click="AddDestinationButton_Click">
                                        + وصول
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="DestinationsPanel"
                                            AutomationProperties.AutomationId="TripDestinationsPanel"
                                            AutomationProperties.Name="قائمة مناطق الوصول">
                                    <TextBox x:Name="EndLocationTextBox"
                                             AutomationProperties.AutomationId="TripDestinationTextBox1"
                                             AutomationProperties.Name="منطقة وصول 1"
                                             Style="{StaticResource TripInputTextBoxStyle}"
                                             ToolTip="اكتب منطقة الوصول" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource TripPopupCardStyle}"
                        Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="ملخص العربية"
                                   Style="{StaticResource TripSectionTitleStyle}" />

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Background="{StaticResource TripPopupAccentPaleBrush}"
                                BorderBrush="#C9DAE4"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="رقم السيارة"
                                           Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehiclePlateTextBlock"
                                           Style="{StaticResource TripPopupValueStyle}"
                                           FontSize="20"
                                           Text="اختر سيارة" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource TripSummaryCellStyle}"
                                BorderThickness="0,0,1,1">
                            <StackPanel>
                                <TextBlock Text="سنة الصنع" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleYearTextBlock" Style="{StaticResource TripPopupValueStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource TripSummaryCellStyle}">
                            <StackPanel>
                                <TextBlock Text="الموديل" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleModelTextBlock" Style="{StaticResource TripPopupValueStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="3"
                                Style="{StaticResource TripSummaryCellStyle}"
                                BorderThickness="0,0,1,1">
                            <StackPanel>
                                <TextBlock Text="رقم الشاسيه" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleChassisTextBlock" Style="{StaticResource TripPopupValueStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource TripSummaryCellStyle}">
                            <StackPanel>
                                <TextBlock Text="رقم الموتور" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleEngineTextBlock" Style="{StaticResource TripPopupValueStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4"
                                Style="{StaticResource TripSummaryCellStyle}"
                                BorderThickness="0,0,1,1">
                            <StackPanel>
                                <TextBlock Text="بداية الترخيص" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleRegistrationStartTextBlock" Style="{StaticResource TripPopupValueStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource TripSummaryCellStyle}">
                            <StackPanel>
                                <TextBlock Text="انتهاء الترخيص" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleRegistrationExpiryTextBlock" Style="{StaticResource TripPopupValueStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="5"
                                Style="{StaticResource TripSummaryCellStyle}"
                                BorderThickness="0,0,1,1"
                                Padding="12,12">
                            <StackPanel>
                                <TextBlock Text="عداد بداية التشغيل" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleCurrentMileageTextBlock"
                                           Style="{StaticResource TripPopupValueStyle}"
                                           Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource TripSummaryCellStyle}"
                                BorderThickness="0,0,0,1"
                                Padding="12,12">
                            <StackPanel>
                                <TextBlock Text="حالة العربية" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleStatusTextBlock"
                                           Style="{StaticResource TripPopupValueStyle}"
                                           Text="—" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource TripSummaryCellStyle}"
                                BorderThickness="0"
                                Padding="12,12">
                            <StackPanel>
                                <TextBlock Text="بيانات التأمين" Style="{StaticResource TripPopupLabelStyle}" />
                                <TextBlock x:Name="VehicleInsuranceTextBlock"
                                           Style="{StaticResource TripPopupValueStyle}"
                                           Text="—" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource TripPopupSurfaceBrush}"
                BorderBrush="{StaticResource TripPopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        FlowDirection="LeftToRight">
                <Button Style="{StaticResource TripPopupPrimaryButtonStyle}"
                        AutomationProperties.AutomationId="TripSaveButton"
                        IsDefault="True"
                        Click="SaveButton_Click">
                    حفظ التشغيل
                </Button>
                <Button Style="{StaticResource TripPopupSecondaryButtonStyle}"
                        AutomationProperties.AutomationId="TripCancelButton"
                        Margin="10,0,0,0"
                        IsCancel="True"
                        Click="CancelButton_Click">
                    إلغاء
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
