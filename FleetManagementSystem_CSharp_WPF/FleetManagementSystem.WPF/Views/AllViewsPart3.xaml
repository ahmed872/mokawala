<!-- ============================================================================
     FILE: LicenseListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Licenses/LicenseListView.xaml
     VIEWMODEL: LicenseViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Licenses.LicenseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="الرخص" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="إضافة رخصة جديدة" 
                        Command="{Binding AddLicenseCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن السائق أو رقم الرخصة..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding LicenseStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Licenses DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Licenses}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedLicense}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="السائق" Binding="{Binding DriverName}" Width="150"/>
                        <DataGridTextColumn Header="رقم الرخصة" Binding="{Binding LicenseNumber}" Width="120"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding LicenseType}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ الإصدار" Binding="{Binding IssuanceDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="150"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditLicenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteLicenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- Alerts -->
            <Border Background="{StaticResource WarningBrush}" CornerRadius="8" Padding="15" 
                    Visibility="{Binding ExpiringLicensesCount, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="{Binding ExpiringLicensesMessage}" Foreground="White" FontSize="12"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: InsuranceListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Insurance/InsuranceListView.xaml
     VIEWMODEL: InsuranceViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Insurance.InsuranceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="التأمين" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="إضافة بوليصة تأمين" 
                        Command="{Binding AddInsuranceCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن المركبة أو شركة التأمين..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding InsuranceStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Insurance DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Insurances}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedInsurance}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="شركة التأمين" Binding="{Binding InsuranceCompany}" Width="150"/>
                        <DataGridTextColumn Header="رقم البوليصة" Binding="{Binding PolicyNumber}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding EndDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="المبلغ المؤمن" Binding="{Binding CoverageAmount, StringFormat='SAR {0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="القسط السنوي" Binding="{Binding PremiumAmount, StringFormat='SAR {0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditInsuranceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteInsuranceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: CustodyListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Custody/CustodyListView.xaml
     VIEWMODEL: CustodyViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Custody.CustodyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="الحراسة والعهد" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="إضافة عهدة جديدة" 
                        Command="{Binding AddCustodyCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن الموظف أو الصنف..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding CustodyStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Custody DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Custodies}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedCustody}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="150"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemType}" Width="120"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="150"/>
                        <DataGridTextColumn Header="القيمة" Binding="{Binding ItemValue, StringFormat='SAR {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ الاستلام" Binding="{Binding IssuanceDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ الإرجاع" Binding="{Binding ReturnDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditCustodyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="إرجاع" Command="{Binding DataContext.ReturnCustodyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SuccessButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: MasterDataView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/MasterData/MasterDataView.xaml
     VIEWMODEL: MasterDataViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.MasterData.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <TextBlock Text="البيانات الأساسية والإعدادات" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}"/>
            
            <!-- Tab Control for different master data sections -->
            <TabControl>
                <!-- Vehicle Types Tab -->
                <TabItem Header="أنواع المركبات">
                    <StackPanel Margin="15" Spacing="15">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Text="{Binding NewVehicleType, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10" FontSize="12" 
                                     Background="{StaticResource InputBackgroundBrush}"
                                     Watermark="أدخل نوع مركبة جديد..."/>
                            
                            <Button Grid.Column="1" Content="إضافة" 
                                    Command="{Binding AddVehicleTypeCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                        </Grid>
                        
                        <ListBox ItemsSource="{Binding VehicleTypes}" Height="300"
                                 Background="{StaticResource CardBrush}" BorderThickness="1"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding TypeName}" VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="1" Content="حذف" 
                                                Command="{Binding DataContext.DeleteVehicleTypeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}" Padding="10,5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </TabItem>
                
                <!-- Contract Statuses Tab -->
                <TabItem Header="حالات العقود">
                    <StackPanel Margin="15" Spacing="15">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Text="{Binding NewContractStatus, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10" FontSize="12" 
                                     Background="{StaticResource InputBackgroundBrush}"
                                     Watermark="أدخل حالة عقد جديدة..."/>
                            
                            <Button Grid.Column="1" Content="إضافة" 
                                    Command="{Binding AddContractStatusCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                        </Grid>
                        
                        <ListBox ItemsSource="{Binding ContractStatuses}" Height="300"
                                 Background="{StaticResource CardBrush}" BorderThickness="1"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding StatusName}" VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="1" Content="حذف" 
                                                Command="{Binding DataContext.DeleteContractStatusCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}" Padding="10,5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </TabItem>
                
                <!-- Maintenance Types Tab -->
                <TabItem Header="أنواع الصيانة">
                    <StackPanel Margin="15" Spacing="15">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Text="{Binding NewMaintenanceType, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10" FontSize="12" 
                                     Background="{StaticResource InputBackgroundBrush}"
                                     Watermark="أدخل نوع صيانة جديد..."/>
                            
                            <Button Grid.Column="1" Content="إضافة" 
                                    Command="{Binding AddMaintenanceTypeCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                        </Grid>
                        
                        <ListBox ItemsSource="{Binding MaintenanceTypes}" Height="300"
                                 Background="{StaticResource CardBrush}" BorderThickness="1"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding TypeName}" VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="1" Content="حذف" 
                                                Command="{Binding DataContext.DeleteMaintenanceTypeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}" Padding="10,5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </TabItem>
                
                <!-- Service Providers Tab -->
                <TabItem Header="مقدمو الخدمات">
                    <StackPanel Margin="15" Spacing="15">
                        <Button Content="إضافة مقدم خدمة جديد" 
                                Command="{Binding AddServiceProviderCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="20,10" HorizontalAlignment="Left"/>
                        
                        <DataGrid ItemsSource="{Binding ServiceProviders}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" RowHeight="40" BorderThickness="0"
                                  Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding ProviderName}" Width="150"/>
                                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="150"/>
                                <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="200"/>
                                <DataGridTemplateColumn Header="الإجراءات" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Button Content="تعديل" Command="{Binding DataContext.EditServiceProviderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                                <Button Content="حذف" Command="{Binding DataContext.DeleteServiceProviderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: ReportsView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Reports/ReportsView.xaml
     VIEWMODEL: ReportsViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <TextBlock Text="التقارير والتصدير" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}"/>
            
            <!-- Report Selection Grid -->
            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Vehicles Report -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="تقرير المركبات" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="تقرير شامل لجميع المركبات والحالات" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="عرض" Command="{Binding ViewVehiclesReportCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="15,8"/>
                            <Button Content="Excel" Command="{Binding ExportVehiclesExcelCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                            <Button Content="PDF" Command="{Binding ExportVehiclesPdfCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Contracts Report -->
                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="تقرير العقود" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="تقرير شامل لجميع العقود والقيم" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="عرض" Command="{Binding ViewContractsReportCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="15,8"/>
                            <Button Content="Excel" Command="{Binding ExportContractsExcelCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                            <Button Content="PDF" Command="{Binding ExportContractsPdfCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Maintenance Report -->
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="تقرير الصيانة" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="تقرير شامل لطلبات الصيانة والتكاليف" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="عرض" Command="{Binding ViewMaintenanceReportCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="15,8"/>
                            <Button Content="Excel" Command="{Binding ExportMaintenanceExcelCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                            <Button Content="PDF" Command="{Binding ExportMaintenancePdfCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Fuel Report -->
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="تقرير الوقود" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="تقرير تكاليف الوقود والاستهلاك" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="عرض" Command="{Binding ViewFuelReportCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="15,8"/>
                            <Button Content="Excel" Command="{Binding ExportFuelExcelCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                            <Button Content="PDF" Command="{Binding ExportFuelPdfCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Expenses Report -->
                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="تقرير المصروفات" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="تقرير شامل لجميع المصروفات والفئات" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="عرض" Command="{Binding ViewExpensesReportCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="15,8"/>
                            <Button Content="Excel" Command="{Binding ExportExpensesExcelCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                            <Button Content="PDF" Command="{Binding ExportExpensesPdfCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: SettingsView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Settings/SettingsView.xaml
     VIEWMODEL: SettingsViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <TextBlock Text="الإعدادات" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}"/>
            
            <!-- Tab Control for settings sections -->
            <TabControl>
                <!-- Company Settings Tab -->
                <TabItem Header="إعدادات الشركة">
                    <StackPanel Margin="15" Spacing="15">
                        <!-- Company Name -->
                        <StackPanel>
                            <TextBlock Text="اسم الشركة" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CompanySettings.CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10" FontSize="12" 
                                     Background="{StaticResource InputBackgroundBrush}"/>
                        </StackPanel>
                        
                        <!-- Phone -->
                        <StackPanel>
                            <TextBlock Text="رقم الهاتف" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CompanySettings.Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10" FontSize="12" 
                                     Background="{StaticResource InputBackgroundBrush}"/>
                        </StackPanel>
                        
                        <!-- Email -->
                        <StackPanel>
                            <TextBlock Text="البريد الإلكتروني" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CompanySettings.Email, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10" FontSize="12" 
                                     Background="{StaticResource InputBackgroundBrush}"/>
                        </StackPanel>
                        
                        <!-- Logo Upload -->
                        <StackPanel>
                            <TextBlock Text="شعار الشركة" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0" Text="{Binding CompanySettings.LogoPath, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10" FontSize="12" IsReadOnly="True"
                                         Background="{StaticResource InputBackgroundBrush}"/>
                                
                                <Button Grid.Column="1" Content="اختيار صورة" 
                                        Command="{Binding SelectLogoCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Save Button -->
                        <Button Content="حفظ الإعدادات" 
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="20,12" 
                                HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </TabItem>
                
                <!-- User Management Tab -->
                <TabItem Header="إدارة المستخدمين">
                    <StackPanel Margin="15" Spacing="15">
                        <Button Content="إضافة مستخدم جديد" 
                                Command="{Binding AddUserCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="20,10" 
                                HorizontalAlignment="Left"/>
                        
                        <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" RowHeight="40" BorderThickness="0"
                                  Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="200"/>
                                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="150"/>
                                <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="100"/>
                                <DataGridTextColumn Header="نشط" Binding="{Binding IsActive}" Width="80"/>
                                <DataGridTemplateColumn Header="الإجراءات" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Button Content="تعديل" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                                <Button Content="حذف" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                
                <!-- Change Password Tab -->
                <TabItem Header="تغيير كلمة المرور">
                    <StackPanel Margin="15" Spacing="15" MaxWidth="400">
                        <!-- Current Password -->
                        <StackPanel>
                            <TextBlock Text="كلمة المرور الحالية" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="CurrentPasswordBox" Padding="10" FontSize="12" 
                                        Background="{StaticResource InputBackgroundBrush}"/>
                        </StackPanel>
                        
                        <!-- New Password -->
                        <StackPanel>
                            <TextBlock Text="كلمة المرور الجديدة" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="NewPasswordBox" Padding="10" FontSize="12" 
                                        Background="{StaticResource InputBackgroundBrush}"/>
                        </StackPanel>
                        
                        <!-- Confirm Password -->
                        <StackPanel>
                            <TextBlock Text="تأكيد كلمة المرور" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Padding="10" FontSize="12" 
                                        Background="{StaticResource InputBackgroundBrush}"/>
                        </StackPanel>
                        
                        <!-- Change Button -->
                        <Button Content="تغيير كلمة المرور" 
                                Command="{Binding ChangePasswordCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="20,12" 
                                Margin="0,20,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</UserControl>

