     ============================================================================ -->

<!-- ============================================================================
     FILE: DashboardView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Dashboard/DashboardView.xaml
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="20">
            <!-- Title -->
            <TextBlock Text="لوحة التحكم" FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,20"/>
            
            <!-- KPI Cards Row 1 -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Total Vehicles Card -->
                <Border Grid.Column="0" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="إجمالي المركبات" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalVehicles}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ActiveVehicles, StringFormat='نشطة: {0}'}" 
                                   FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Contracts Card -->
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="إجمالي العقود" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalContracts}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ActiveContracts, StringFormat='نشطة: {0}'}" 
                                   FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Open Maintenance Card -->
                <Border Grid.Column="2" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="طلبات الصيانة المفتوحة" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding OpenMaintenanceRequests}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="تحتاج إلى اهتمام" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- KPI Cards Row 2 -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Expiring Contracts Card -->
                <Border Grid.Column="0" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="العقود المنتهية قريباً (30 يوم)" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding ExpiringContractsCount}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"/>
                        <Button Content="عرض التفاصيل" Command="{Binding ViewExpiringContractsCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Maintenance Cost Card -->
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="إجمالي تكاليف الصيانة" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalMaintenanceCost, StringFormat='SAR {0:N2}'}" 
                                   FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="هذا الشهر" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Alerts Section -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="20" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel>
                    <TextBlock Text="التنبيهات والتحذيرات" FontSize="16" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AlertBackgroundBrush}" 
                                        CornerRadius="4" Padding="12" Margin="0,0,0,10" 
                                        BorderThickness="1" BorderBrush="{StaticResource AlertBorderBrush}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚠" FontSize="16" Foreground="{StaticResource WarningBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" 
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            
            <!-- Recent Activity Section -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="20" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel>
                    <TextBlock Text="آخر النشاطات" FontSize="16" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>
                    <DataGrid ItemsSource="{Binding RecentActivities}" AutoGenerateColumns="False" 
                              IsReadOnly="True" RowHeight="40" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الإجراء" Binding="{Binding Action}" Width="*"/>
                            <DataGridTextColumn Header="الكيان" Binding="{Binding EntityType}" Width="100"/>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: VehicleListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Vehicles/VehicleListView.xaml
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Vehicles.VehicleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="المركبات" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="إضافة مركبة جديدة" 
                        Command="{Binding AddVehicleCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن لوحة الترخيص أو الطراز..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding VehicleStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
                
                <ComboBox Grid.Column="2" ItemsSource="{Binding VehicleTypes}" 
                          SelectedItem="{Binding SelectedType}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Vehicles DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Vehicles}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedVehicle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="لوحة الترخيص" Binding="{Binding PlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding VehicleTypeName}" Width="100"/>
                        <DataGridTextColumn Header="الطراز" Binding="{Binding Model}" Width="100"/>
                        <DataGridTextColumn Header="السنة" Binding="{Binding Year}" Width="80"/>
                        <DataGridTextColumn Header="المسافة" Binding="{Binding Mileage, StringFormat='{0:N0} km'}" Width="100"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Content="السابق" Command="{Binding PreviousPageCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}"/>
                <TextBlock Text="{Binding CurrentPage, StringFormat='الصفحة {0}'}" 
                           VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Button Content="التالي" Command="{Binding NextPageCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: VehicleFormDialog.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Vehicles/VehicleFormDialog.xaml
     ============================================================================ -->
<Window x:Class="FleetManagementSystem.WPF.Views.Vehicles.VehicleFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نموذج المركبة" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Plate Number -->
            <StackPanel>
                <TextBlock Text="لوحة الترخيص" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Vehicle.PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
                <TextBlock Text="{Binding Errors[PlateNumber]}" Foreground="{StaticResource DangerBrush}" 
                           FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            
            <!-- Vehicle Type -->
            <StackPanel>
                <TextBlock Text="نوع المركبة" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding VehicleTypes}" 
                          SelectedItem="{Binding Vehicle.VehicleTypeId}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Make -->
            <StackPanel>
                <TextBlock Text="الصانع" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Vehicle.Make, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Model -->
            <StackPanel>
                <TextBlock Text="الطراز" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Vehicle.Model, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Year -->
            <StackPanel>
                <TextBlock Text="السنة" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Vehicle.Year, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Mileage -->
            <StackPanel>
                <TextBlock Text="المسافة المقطوعة" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Vehicle.Mileage, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Status -->
            <StackPanel>
                <TextBlock Text="الحالة" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Statuses}" 
                          SelectedItem="{Binding Vehicle.Status}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Grid ColumnSpacing="10" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="حفظ" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,12"/>
                
                <Button Grid.Column="1" Content="إلغاء" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="20,12"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>

<!-- ============================================================================
     FILE: ContractListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Contracts/ContractListView.xaml
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Contracts.ContractListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="العقود" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="عقد جديد" 
                        Command="{Binding AddContractCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن رقم العقد أو العميل..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding ContractStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Contracts DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Contracts}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedContract}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="120"/>
                        <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding ClientName}" Width="150"/>
                        <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ النهاية" Binding="{Binding EndDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="القيمة" Binding="{Binding ContractValue, StringFormat='SAR {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditContractCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteContractCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: MaintenanceListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Maintenance/MaintenanceListView.xaml
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Maintenance.MaintenanceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="طلبات الصيانة" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="طلب صيانة جديد" 
                        Command="{Binding AddMaintenanceCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن المركبة أو نوع الصيانة..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding MaintenanceStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
                
                <ComboBox Grid.Column="2" ItemsSource="{Binding MaintenanceTypes}" 
                          SelectedItem="{Binding SelectedType}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Maintenance DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding MaintenanceRequests}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedMaintenance}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="نوع الصيانة" Binding="{Binding MaintenanceTypeName}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ الطلب" Binding="{Binding RequestDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="التكلفة المقدرة" Binding="{Binding EstimatedCost, StringFormat='SAR {0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="التكلفة الفعلية" Binding="{Binding ActualCost, StringFormat='SAR {0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="مزود الخدمة" Binding="{Binding ServiceProviderName}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditMaintenanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="إكمال" Command="{Binding DataContext.CompleteMaintenanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SuccessButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

