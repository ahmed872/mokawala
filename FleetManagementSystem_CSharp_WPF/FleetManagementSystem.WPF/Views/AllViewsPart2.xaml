<!-- ============================================================================
     FILE: DriverListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Drivers/DriverListView.xaml
     VIEWMODEL: DriverViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Drivers.DriverListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="السائقون" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="إضافة سائق جديد" 
                        Command="{Binding AddDriverCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن الاسم أو رقم الرخصة..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding Statuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Drivers DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Drivers}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedDriver}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="150"/>
                        <DataGridTextColumn Header="رقم الرخصة" Binding="{Binding LicenseNumber}" Width="120"/>
                        <DataGridTextColumn Header="انتهاء الرخصة" Binding="{Binding LicenseExpiryDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="150"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditDriverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteDriverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: DriverFormDialog.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Drivers/DriverFormDialog.xaml
     VIEWMODEL: DriverViewModel
     ============================================================================ -->
<Window x:Class="FleetManagementSystem.WPF.Views.Drivers.DriverFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نموذج السائق" Height="600" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                <!-- Full Name -->
                <StackPanel>
                    <TextBlock Text="الاسم الكامل" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Driver.FullName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                    <TextBlock Text="{Binding Errors[FullName]}" Foreground="{StaticResource DangerBrush}" 
                               FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                
                <!-- License Number -->
                <StackPanel>
                    <TextBlock Text="رقم الرخصة" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Driver.LicenseNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- License Expiry Date -->
                <StackPanel>
                    <TextBlock Text="تاريخ انتهاء الرخصة" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding Driver.LicenseExpiryDate}"
                                Padding="10" FontSize="12"
                                Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Phone Number -->
                <StackPanel>
                    <TextBlock Text="رقم الهاتف" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Driver.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Email -->
                <StackPanel>
                    <TextBlock Text="البريد الإلكتروني" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Driver.Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- National ID -->
                <StackPanel>
                    <TextBlock Text="رقم الهوية الوطنية" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Driver.NationalId, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Date of Birth -->
                <StackPanel>
                    <TextBlock Text="تاريخ الميلاد" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding Driver.DateOfBirth}"
                                Padding="10" FontSize="12"
                                Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Status -->
                <StackPanel>
                    <TextBlock Text="الحالة" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Statuses}" 
                              SelectedItem="{Binding Driver.Status}"
                              Padding="10" FontSize="12"
                              Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Buttons -->
                <Grid ColumnSpacing="10" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="حفظ" 
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="20,12"/>
                    
                    <Button Grid.Column="1" Content="إلغاء" 
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="20,12"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

