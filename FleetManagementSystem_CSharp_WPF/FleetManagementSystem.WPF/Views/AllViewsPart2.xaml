            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedExpense}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ExpenseType}" Width="120"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='SAR {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="150"/>
                        <DataGridTextColumn Header="المورد" Binding="{Binding Vendor}" Width="120"/>
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
