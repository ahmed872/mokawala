<!-- ============================================================================
     FILE: TripListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Trips/TripListView.xaml
     VIEWMODEL: TripViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Trips.TripListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="الرحلات والعمليات" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="رحلة جديدة" 
                        Command="{Binding AddTripCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن المركبة أو السائق..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding TripStatuses}" 
                          SelectedItem="{Binding SelectedStatus}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Trips DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding Trips}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedTrip}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="السائق" Binding="{Binding DriverName}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ الرحلة" Binding="{Binding TripDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="من" Binding="{Binding StartLocation}" Width="120"/>
                        <DataGridTextColumn Header="إلى" Binding="{Binding EndLocation}" Width="120"/>
                        <DataGridTextColumn Header="المسافة المخطط" Binding="{Binding PlannedDistance, StringFormat='{0:N0} km'}" Width="120"/>
                        <DataGridTextColumn Header="المسافة الفعلية" Binding="{Binding ActualDistance, StringFormat='{0:N0} km'}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="إكمال" Command="{Binding DataContext.CompleteTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SuccessButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<!-- ============================================================================
     FILE: FuelListView.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Fuel/FuelListView.xaml
     VIEWMODEL: FuelViewModel
     ============================================================================ -->
<UserControl x:Class="FleetManagementSystem.WPF.Views.Fuel.FuelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Header -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="معاملات الوقود" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <Button Grid.Column="1" Content="إضافة معاملة وقود" 
                        Command="{Binding AddFuelCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
                
                <Button Grid.Column="2" Content="تحديث" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="15,10"/>
            </Grid>
            
            <!-- Search and Filter -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Watermark="ابحث عن المركبة أو المحطة..."/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding FuelTypes}" 
                          SelectedItem="{Binding SelectedFuelType}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </Grid>
            
            <!-- Fuel DataGrid -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <DataGrid ItemsSource="{Binding FuelTransactions}" AutoGenerateColumns="False" 
                          IsReadOnly="True" RowHeight="50" BorderThickness="0"
                          SelectedItem="{Binding SelectedFuel}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المركبة" Binding="{Binding VehiclePlateNumber}" Width="120"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="عدد اللترات" Binding="{Binding Quantity, StringFormat='{0:N2} L'}" Width="120"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat='SAR {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat='SAR {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="المسافة" Binding="{Binding Mileage, StringFormat='{0:N0} km'}" Width="100"/>
                        <DataGridTextColumn Header="نوع الوقود" Binding="{Binding FuelType}" Width="100"/>
                        <DataGridTextColumn Header="المحطة" Binding="{Binding Station}" Width="100"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="تعديل" Command="{Binding DataContext.EditFuelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteFuelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- Summary Cards -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="إجمالي تكاليف الوقود" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalFuelCost, StringFormat='SAR {0:N2}'}" 
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="متوسط الاستهلاك" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding AverageFuelConsumption, StringFormat='{0:N2} L/100km'}" 
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

