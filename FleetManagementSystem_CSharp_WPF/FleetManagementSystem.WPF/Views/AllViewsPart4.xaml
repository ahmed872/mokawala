        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نموذج مقدم الخدمة" Height="400" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Provider Name -->
            <StackPanel>
                <TextBlock Text="اسم مقدم الخدمة" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ServiceProvider.ProviderName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Phone -->
            <StackPanel>
                <TextBlock Text="رقم الهاتف" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ServiceProvider.Phone, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Email -->
            <StackPanel>
                <TextBlock Text="البريد الإلكتروني" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ServiceProvider.Email, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Address -->
            <StackPanel>
                <TextBlock Text="العنوان" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ServiceProvider.Address, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" Height="60"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Grid ColumnSpacing="10" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="حفظ" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,12"/>
                
                <Button Grid.Column="1" Content="إلغاء" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="20,12"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
