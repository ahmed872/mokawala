<!-- ============================================================================
     FILE: UserFormDialog.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Settings/UserFormDialog.xaml
     VIEWMODEL: SettingsViewModel
     ============================================================================ -->
<Window x:Class="FleetManagementSystem.WPF.Views.Settings.UserFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نموذج المستخدم" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Username -->
            <StackPanel>
                <TextBlock Text="اسم المستخدم" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding User.Username, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Email -->
            <StackPanel>
                <TextBlock Text="البريد الإلكتروني" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding User.Email, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Full Name -->
            <StackPanel>
                <TextBlock Text="الاسم الكامل" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding User.FullName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Role -->
            <StackPanel>
                <TextBlock Text="الدور" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Roles}" 
                          SelectedItem="{Binding User.Role}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Is Active -->
            <StackPanel>
                <CheckBox IsChecked="{Binding User.IsActive}" Content="نشط" FontSize="12"/>
            </StackPanel>
            
            <!-- Password (for new users) -->
            <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="كلمة المرور" FontWeight="Bold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Padding="10" FontSize="12" 
                            Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Grid ColumnSpacing="10" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="حفظ" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="20,12"/>
                
                <Button Grid.Column="1" Content="إلغاء" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="20,12"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>

<!-- ============================================================================
