<!-- ============================================================================
     FILE: TripFormDialog.xaml
     LOCATION: FleetManagementSystem.WPF/Views/Trips/TripFormDialog.xaml
     VIEWMODEL: TripViewModel
     ============================================================================ -->
<Window x:Class="FleetManagementSystem.WPF.Views.Trips.TripFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نموذج الرحلة" Height="600" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                <!-- Vehicle Selection -->
                <StackPanel>
                    <TextBlock Text="المركبة" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Vehicles}" 
                              SelectedItem="{Binding Trip.Vehicle}"
                              DisplayMemberPath="PlateNumber"
                              Padding="10" FontSize="12"
                              Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Driver Selection -->
                <StackPanel>
                    <TextBlock Text="السائق" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Drivers}" 
                              SelectedItem="{Binding Trip.Driver}"
                              DisplayMemberPath="FullName"
                              Padding="10" FontSize="12"
                              Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Trip Date -->
                <StackPanel>
                    <TextBlock Text="تاريخ الرحلة" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding Trip.TripDate}"
                                Padding="10" FontSize="12"
                                Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Start Location -->
                <StackPanel>
                    <TextBlock Text="نقطة البداية" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Trip.StartLocation, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- End Location -->
                <StackPanel>
                    <TextBlock Text="نقطة النهاية" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Trip.EndLocation, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Planned Distance -->
                <StackPanel>
                    <TextBlock Text="المسافة المخطط (كم)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Trip.PlannedDistance, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Actual Distance -->
                <StackPanel>
                    <TextBlock Text="المسافة الفعلية (كم)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Trip.ActualDistance, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" 
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Trip Status -->
                <StackPanel>
                    <TextBlock Text="الحالة" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding TripStatuses}" 
                              SelectedItem="{Binding Trip.Status}"
                              Padding="10" FontSize="12"
                              Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Notes -->
                <StackPanel>
                    <TextBlock Text="ملاحظات" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Trip.Notes, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="12" Height="80"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource InputBackgroundBrush}"/>
                </StackPanel>
                
                <!-- Buttons -->
                <Grid ColumnSpacing="10" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="حفظ" 
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="20,12"/>
                    
                    <Button Grid.Column="1" Content="إلغاء" 
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="20,12"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<!-- ============================================================================
