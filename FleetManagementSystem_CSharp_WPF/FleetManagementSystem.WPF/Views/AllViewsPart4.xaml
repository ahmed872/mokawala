        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- Vehicle Selection -->
            <StackPanel>
                <TextBlock Text="المركبة" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Vehicles}" 
                          SelectedItem="{Binding Fuel.Vehicle}"
                          DisplayMemberPath="PlateNumber"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Transaction Date -->
            <StackPanel>
                <TextBlock Text="التاريخ" FontWeight="Bold" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding Fuel.TransactionDate}"
                            Padding="10" FontSize="12"
                            Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Quantity -->
            <StackPanel>
                <TextBlock Text="عدد اللترات" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Fuel.Quantity, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Unit Price -->
            <StackPanel>
                <TextBlock Text="سعر اللتر" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Fuel.UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Fuel Type -->
            <StackPanel>
                <TextBlock Text="نوع الوقود" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding FuelTypes}" 
                          SelectedItem="{Binding Fuel.FuelType}"
                          Padding="10" FontSize="12"
                          Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Station -->
            <StackPanel>
                <TextBlock Text="محطة البنزين" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Fuel.Station, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
                         Background="{StaticResource InputBackgroundBrush}"/>
            </StackPanel>
            
            <!-- Mileage -->
            <StackPanel>
                <TextBlock Text="عداد التموين" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Fuel.Mileage, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" FontSize="12" 
