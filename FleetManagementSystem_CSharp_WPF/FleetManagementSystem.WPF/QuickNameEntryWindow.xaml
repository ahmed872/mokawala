<Window x:Class="FleetManagementSystem.WPF.QuickNameEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة اسم"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Cairo, Segoe UI, Tahoma">
    <Border Margin="18"
            Padding="22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="HintTextBlock"
                       Margin="0,6,0,18"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="الاسم"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="NameTextBox"
                     AutomationProperties.AutomationId="QuickNameTextBox"
                     AutomationProperties.Name="الاسم"
                     Style="{StaticResource AppTextBoxStyle}"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        FlowDirection="LeftToRight"
                        Margin="0,22,0,0">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.AutomationId="QuickNameSaveButton"
                        IsDefault="True"
                        Click="SaveButton_Click">
                    حفظ
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="QuickNameCancelButton"
                        Margin="10,0,0,0"
                        IsCancel="True"
                        Click="CancelButton_Click">
                    إلغاء
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
