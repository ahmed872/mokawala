<Window x:Class="FleetManagementSystem.WPF.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Cairo, Segoe UI, Tahoma">
    <Border Margin="18"
            Padding="22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock Text="تغيير كلمة المرور"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,6,0,18"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="كلمة المرور الجديدة يجب ألا تقل عن 8 أحرف وتحتوي على حرف ورقم ورمز، ولا يمكن أن تكون نفس اسم المستخدم."/>

            <TextBlock Text="كلمة المرور الحالية"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         AutomationProperties.AutomationId="ChangePasswordCurrent"
                         Height="42"
                         Padding="10,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

            <TextBlock Text="كلمة المرور الجديدة"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox"
                         AutomationProperties.AutomationId="ChangePasswordNew"
                         Height="42"
                         Padding="10,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

            <TextBlock Text="تأكيد كلمة المرور الجديدة"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         AutomationProperties.AutomationId="ChangePasswordConfirm"
                         Height="42"
                         Padding="10,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"/>

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="#C62828"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        FlowDirection="LeftToRight"
                        Margin="0,18,0,0">
                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.AutomationId="ChangePasswordSaveButton"
                        IsDefault="True"
                        Click="SaveButton_Click">
                    حفظ كلمة المرور
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="ChangePasswordCancelButton"
                        Margin="10,0,0,0"
                        IsCancel="True"
                        Click="CancelButton_Click">
                    إلغاء
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
