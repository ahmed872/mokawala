<Window x:Class="FleetManagementSystem.WPF.UserEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مستخدم جديد"
        Width="920"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="UserEntryWindow"
        AutomationProperties.Name="نافذة إضافة مستخدم جديد"
        FlowDirection="RightToLeft"
        Background="#F6F8F4">
        <Window.Resources>
                <SolidColorBrush x:Key="UserPopupSurfaceBrush"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="UserPopupAltBrush"
                                 Color="#EFF4EF"/>
                <SolidColorBrush x:Key="UserPopupAccentBrush"
                                 Color="#53766A"/>
                <SolidColorBrush x:Key="UserPopupAccentPaleBrush"
                                 Color="#E6F0EB"/>
                <SolidColorBrush x:Key="UserPopupTextBrush"
                                 Color="#24333A"/>
                <SolidColorBrush x:Key="UserPopupMutedBrush"
                                 Color="#6A7880"/>
                <SolidColorBrush x:Key="UserPopupBorderBrush"
                                 Color="#D7E2DB"/>

                <Style x:Key="UserPopupCardStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="{StaticResource UserPopupSurfaceBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource UserPopupBorderBrush}"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="CornerRadius"
                                Value="24"/>
                        <Setter Property="Padding"
                                Value="22"/>
                </Style>

                <Style x:Key="UserPopupLabelStyle"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{StaticResource UserPopupTextBrush}"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                </Style>

                <Style x:Key="UserPopupPrimaryButtonStyle"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="46"/>
                        <Setter Property="MinWidth"
                                Value="130"/>
                        <Setter Property="Margin"
                                Value="0,0,10,0"/>
                        <Setter Property="Padding"
                                Value="20,8"/>
                        <Setter Property="FontSize"
                                Value="15"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Background"
                                Value="{StaticResource UserPopupAccentBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource UserPopupAccentBrush}"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.92"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.82"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="UserPopupSecondaryButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource UserPopupPrimaryButtonStyle}">
                        <Setter Property="Foreground"
                                Value="{StaticResource UserPopupTextBrush}"/>
                        <Setter Property="Background"
                                Value="{StaticResource UserPopupAltBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource UserPopupBorderBrush}"/>
                </Style>
        </Window.Resources>

        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource UserPopupCardStyle}"
                        Background="{StaticResource UserPopupAccentPaleBrush}">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                        <TextBlock x:Name="HeaderTitleTextBlock"
                                                   Text="إضافة مستخدم جديد"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource UserPopupTextBrush}"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource UserPopupMutedBrush}"
                                                   Text="اختر دور المستخدم من القائمة، وستحدد صلاحياته تلقائيًا داخل النظام."
                                                   TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="62"
                                        Height="62"
                                        Background="{StaticResource UserPopupSurfaceBrush}"
                                        BorderBrush="{StaticResource UserPopupBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                        <TextBlock Text="+"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource UserPopupAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>
                        </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,18"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                                <Border Style="{StaticResource UserPopupCardStyle}"
                                        Margin="0,0,0,18">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,12,14">
                                                        <TextBlock Text="الاسم الكامل"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <TextBox x:Name="FullNameTextBox"
                                                                 AutomationProperties.AutomationId="UserFullNameTextBox"
                                                                 AutomationProperties.Name="الاسم الكامل"
                                                                 Margin="0,8,0,0"
                                                                 Style="{StaticResource AppTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="0,0,0,14">
                                                        <TextBlock Text="اسم الدخول (Username)"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <TextBox x:Name="UsernameTextBox"
                                                                 AutomationProperties.AutomationId="UserUsernameTextBox"
                                                                 AutomationProperties.Name="اسم الدخول"
                                                                 Margin="0,8,0,0"
                                                                 Style="{StaticResource AppTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1"
                                                            Margin="0,0,12,0">
                                                        <TextBlock Text="البريد الإلكتروني"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <TextBox x:Name="EmailTextBox"
                                                                 AutomationProperties.AutomationId="UserEmailTextBox"
                                                                 AutomationProperties.Name="البريد الإلكتروني"
                                                                 Margin="0,8,0,0"
                                                                 Style="{StaticResource AppTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="0,0,0,0">
                                                        <TextBlock Text="رقم الهاتف"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <TextBox x:Name="PhoneTextBox"
                                                                 AutomationProperties.AutomationId="UserPhoneTextBox"
                                                                 AutomationProperties.Name="رقم الهاتف"
                                                                 Margin="0,8,0,0"
                                                                 Style="{StaticResource AppTextBoxStyle}"/>
                                                </StackPanel>
                                        </Grid>
                                </Border>

                                <Border Style="{StaticResource UserPopupCardStyle}"
                                        Margin="0,0,0,18">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,12,14">
                                                        <TextBlock Text="دور المستخدم (الصلاحيات)"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <ComboBox x:Name="RoleComboBox"
                                                                  AutomationProperties.AutomationId="UserRoleComboBox"
                                                                  AutomationProperties.Name="دور المستخدم"
                                                                  Margin="0,8,0,0"
                                                                  Style="{StaticResource AppComboBoxStyle}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedValuePath="Value"
                                                                  SelectionChanged="RoleComboBox_SelectionChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="0,0,0,14"
                                                            VerticalAlignment="Center">
                                                        <CheckBox x:Name="IsActiveCheckBox"
                                                                  AutomationProperties.AutomationId="UserIsActiveCheckBox"
                                                                  Content="الحساب مفعل"
                                                                  Margin="0,28,0,0"
                                                                  IsChecked="True"
                                                                  FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2">
                                                        <TextBlock Text="الشاشات المتاحة لهذا الدور"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <TextBlock x:Name="RoleModulesTextBlock"
                                                                   Margin="0,8,0,0"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource UserPopupMutedBrush}"
                                                                   TextWrapping="Wrap"/>
                                                </StackPanel>
                                        </Grid>
                                </Border>

                                <Border Style="{StaticResource UserPopupCardStyle}">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="كلمة المرور"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <PasswordBox x:Name="PasswordBox"
                                                                     AutomationProperties.AutomationId="UserPasswordBox"
                                                                     AutomationProperties.Name="كلمة المرور"
                                                                     Margin="0,8,0,0"
                                                                     Padding="12,8"
                                                                     ToolTip="8 أحرف على الأقل، تحتوي على حرف ورقم ورمز، ولا تكون نفس اسم الدخول"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                        <TextBlock Text="تأكيد كلمة المرور"
                                                                   Style="{StaticResource UserPopupLabelStyle}"/>
                                                        <PasswordBox x:Name="ConfirmPasswordBox"
                                                                     AutomationProperties.AutomationId="UserConfirmPasswordBox"
                                                                     AutomationProperties.Name="تأكيد كلمة المرور"
                                                                     Margin="0,8,0,0"
                                                                     Padding="12,8"/>
                                                </StackPanel>

                                                <TextBlock x:Name="PasswordHintTextBlock"
                                                           Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,10,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource UserPopupMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="Collapsed"
                                                           Text="اترك الحقلين فارغين إذا كنت لا تريد تغيير كلمة المرور الحالية."/>
                                        </Grid>
                                </Border>
                        </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource UserPopupCardStyle}"
                        Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                                <Button Content="حفظ"
                                        AutomationProperties.AutomationId="UserSaveButton"
                                        Style="{StaticResource UserPopupPrimaryButtonStyle}"
                                        Click="SaveButton_Click"/>
                                <Button Content="إلغاء"
                                        AutomationProperties.AutomationId="UserCancelButton"
                                        Style="{StaticResource UserPopupSecondaryButtonStyle}"
                                        Click="CancelButton_Click"/>
                        </StackPanel>
                </Border>
        </Grid>
</Window>
