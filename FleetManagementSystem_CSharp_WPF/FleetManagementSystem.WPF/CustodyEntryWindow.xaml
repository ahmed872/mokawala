<Window x:Class="FleetManagementSystem.WPF.CustodyEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة عهدة جديدة"
        Width="920"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        Height="700"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        AutomationProperties.AutomationId="CustodyEntryWindow"
        AutomationProperties.Name="نافذة إضافة عهدة جديدة"
        FlowDirection="RightToLeft"
        Background="#F6F8F4">
        <Window.Resources>
                <SolidColorBrush x:Key="CustodyPopupSurfaceBrush"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="CustodyPopupAltBrush"
                                 Color="#EFF4EF"/>
                <SolidColorBrush x:Key="CustodyPopupAccentBrush"
                                 Color="#53766A"/>
                <SolidColorBrush x:Key="CustodyPopupAccentPaleBrush"
                                 Color="#E6F0EB"/>
                <SolidColorBrush x:Key="CustodyPopupTextBrush"
                                 Color="#24333A"/>
                <SolidColorBrush x:Key="CustodyPopupMutedBrush"
                                 Color="#6A7880"/>
                <SolidColorBrush x:Key="CustodyPopupBorderBrush"
                                 Color="#D7E2DB"/>

                <Style x:Key="CustodyPopupCardStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="{StaticResource CustodyPopupSurfaceBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource CustodyPopupBorderBrush}"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="CornerRadius"
                                Value="24"/>
                        <Setter Property="Padding"
                                Value="22"/>
                </Style>

                <Style x:Key="CustodyPopupLabelStyle"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{StaticResource CustodyPopupTextBrush}"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                </Style>

                <Style x:Key="CustodyPopupValueStyle"
                       TargetType="TextBlock">
                        <Setter Property="Margin"
                                Value="0,8,0,0"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource CustodyPopupTextBrush}"/>
                        <Setter Property="FontSize"
                                Value="16"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="TextWrapping"
                                Value="Wrap"/>
                </Style>

                <Style x:Key="CustodyPopupPrimaryButtonStyle"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="46"/>
                        <Setter Property="MinWidth"
                                Value="130"/>
                        <Setter Property="Margin"
                                Value="0,0,10,0"/>
                        <Setter Property="Padding"
                                Value="20,8"/>
                        <Setter Property="FontSize"
                                Value="15"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Background"
                                Value="{StaticResource CustodyPopupAccentBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource CustodyPopupAccentBrush}"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.92"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.82"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="CustodyPopupSecondaryButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource CustodyPopupPrimaryButtonStyle}">
                        <Setter Property="Foreground"
                                Value="{StaticResource CustodyPopupTextBrush}"/>
                        <Setter Property="Background"
                                Value="{StaticResource CustodyPopupAltBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource CustodyPopupBorderBrush}"/>
                </Style>
        </Window.Resources>

        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CustodyPopupCardStyle}"
                        Background="{StaticResource CustodyPopupAccentPaleBrush}">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                        <TextBlock Text="عهدة مالية لأمين عهدة"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CustodyPopupTextBrush}"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource CustodyPopupMutedBrush}"
                                                   Text="العهدة تُسند لسائق أو موظف، ويُخصم مبلغها من الخزينة تلقائيًا في نفس العملية عند اختيار الصرف من الخزينة."
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,0,0">
                                                <TextBlock Text="الأمين المختار: "
                                                           Style="{StaticResource CustodyPopupLabelStyle}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CustodianSummaryTextBlock"
                                                           Text="-"
                                                           Margin="6,0,0,0"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CustodyPopupAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel x:Name="EditBalancePanel"
                                                    Orientation="Horizontal"
                                                    Margin="0,6,0,0"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="المنصرف من العهدة: "
                                                           Style="{StaticResource CustodyPopupLabelStyle}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SettledSummaryTextBlock"
                                                           Text="0"
                                                           Margin="6,0,18,0"
                                                           FontWeight="Bold"
                                                           Foreground="#B26A00"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="الرصيد المتبقي: "
                                                           Style="{StaticResource CustodyPopupLabelStyle}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="RemainingSummaryTextBlock"
                                                           Text="0"
                                                           Margin="6,0,0,0"
                                                           FontWeight="Bold"
                                                           Foreground="#2E7D32"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="62"
                                        Height="62"
                                        Background="{StaticResource CustodyPopupSurfaceBrush}"
                                        BorderBrush="{StaticResource CustodyPopupBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                        <TextBlock Text="+"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CustodyPopupAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>
                        </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,18"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource CustodyPopupCardStyle}">
                                <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="نوع أمين العهدة"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <ComboBox x:Name="CustodianTypeComboBox"
                                                          AutomationProperties.AutomationId="CustodianTypeComboBox"
                                                          AutomationProperties.Name="نوع أمين العهدة"
                                                          Margin="0,8,0,0"
                                                          Style="{StaticResource AppComboBoxStyle}"
                                                          SelectedIndex="0"
                                                          SelectionChanged="CustodianTypeComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="سائق"
                                                                      Tag="Driver"/>
                                                        <ComboBoxItem Content="موظف"
                                                                      Tag="Employee"/>
                                                </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="0,0,0,14">
                                                <TextBlock Text="أمين العهدة"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <ComboBox x:Name="CustodianComboBox"
                                                          AutomationProperties.AutomationId="CustodianComboBox"
                                                          AutomationProperties.Name="أمين العهدة"
                                                          Margin="0,8,0,0"
                                                          Style="{StaticResource AppComboBoxStyle}"
                                                          DisplayMemberPath="FullName"
                                                          SelectedValuePath="Id"
                                                          SelectionChanged="CustodianComboBox_SelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Margin="0,0,12,14">
                                                <TextBlock Text="رقم العهدة"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <TextBox x:Name="CustodyNumberTextBox"
                                                         AutomationProperties.AutomationId="CustodyNumberTextBox"
                                                         AutomationProperties.Name="رقم العهدة"
                                                         Margin="0,8,0,0"
                                                         Style="{StaticResource AppTextBoxStyle}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,14">
                                                <TextBlock Text="مبلغ العهدة"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <TextBox x:Name="AmountTextBox"
                                                         AutomationProperties.AutomationId="CustodyAmountTextBox"
                                                         AutomationProperties.Name="مبلغ العهدة"
                                                         Margin="0,8,0,0"
                                                         Style="{StaticResource AppTextBoxStyle}"
                                                         ToolTip="عند الصرف من الخزينة يُخصم المبلغ تلقائيًا في نفس العملية"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Margin="0,0,12,14">
                                                <TextBlock Text="تاريخ التسليم"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <DatePicker x:Name="HandoverDatePicker"
                                                            AutomationProperties.AutomationId="CustodyHandoverDatePicker"
                                                            AutomationProperties.Name="تاريخ التسليم"
                                                            Margin="0,8,0,0"
                                                            SelectedDateFormat="Short"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,14">
                                                <TextBlock Text="تاريخ الإرجاع"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <DatePicker x:Name="ReturnDatePicker"
                                                            AutomationProperties.AutomationId="CustodyReturnDatePicker"
                                                            AutomationProperties.Name="تاريخ الإرجاع"
                                                            Margin="0,8,0,0"
                                                            SelectedDateFormat="Short"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3"
                                                    Margin="0,0,12,14">
                                                <TextBlock Text="الحالة"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <ComboBox x:Name="StatusComboBox"
                                                          AutomationProperties.AutomationId="CustodyStatusComboBox"
                                                          AutomationProperties.Name="حالة العهدة"
                                                          Margin="0,8,0,0"
                                                          Style="{StaticResource AppComboBoxStyle}"
                                                          SelectedIndex="0">
                                                        <ComboBoxItem Content="نشط"
                                                                      Tag="Active"/>
                                                        <ComboBoxItem Content="مرتجع"
                                                                      Tag="Returned"/>
                                                </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,14"
                                                    VerticalAlignment="Bottom">
                                                <CheckBox x:Name="PaidFromTreasuryCheckBox"
                                                          AutomationProperties.AutomationId="CustodyPaidFromTreasuryCheckBox"
                                                          AutomationProperties.Name="الصرف من الخزينة"
                                                          Content="صرف مبلغ العهدة من الخزينة (خصم فوري متزامن)"
                                                          IsChecked="True"
                                                          FontSize="14"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource CustodyPopupTextBrush}"
                                                          Margin="0,8,0,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4"
                                                    Grid.ColumnSpan="2">
                                                <TextBlock Text="ملاحظات"
                                                           Style="{StaticResource CustodyPopupLabelStyle}"/>
                                                <TextBox x:Name="NotesTextBox"
                                                         AutomationProperties.AutomationId="CustodyNotesTextBox"
                                                         AutomationProperties.Name="ملاحظات العهدة"
                                                         Margin="0,8,0,0"
                                                         MinHeight="82"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource AppTextBoxStyle}"/>
                                        </StackPanel>
                                </Grid>
                        </Border>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource CustodyPopupCardStyle}"
                        Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                                <Button Content="حفظ"
                                        AutomationProperties.AutomationId="CustodySaveButton"
                                        Style="{StaticResource CustodyPopupPrimaryButtonStyle}"
                                        Click="SaveButton_Click"/>
                                <Button Content="إلغاء"
                                        AutomationProperties.AutomationId="CustodyCancelButton"
                                        Style="{StaticResource CustodyPopupSecondaryButtonStyle}"
                                        Click="CancelButton_Click"/>
                        </StackPanel>
                </Border>
        </Grid>
</Window>
