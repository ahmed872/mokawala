<Window x:Class="FleetManagementSystem.WPF.TreasuryEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حركة خزينة"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="TreasuryEntryWindow"
        AutomationProperties.Name="نافذة حركة خزينة"
        FlowDirection="RightToLeft"
        Background="#F6F8FB">
    <Window.Resources>
        <SolidColorBrush x:Key="TreasuryPopupSurfaceBrush"
                Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TreasuryPopupAltBrush"
                Color="#EEF4F7"/>
        <SolidColorBrush x:Key="TreasuryPopupAccentBrush"
                Color="#123B53"/>
        <SolidColorBrush x:Key="TreasuryPopupAccentPaleBrush"
                Color="#EAF2F7"/>
        <SolidColorBrush x:Key="TreasuryPopupTextBrush"
                Color="#1F2D3A"/>
        <SolidColorBrush x:Key="TreasuryPopupMutedBrush"
                Color="#6A7880"/>
        <SolidColorBrush x:Key="TreasuryPopupBorderBrush"
                Color="#D6E4EC"/>

        <Style x:Key="TreasuryPopupCardStyle"
                TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource TreasuryPopupSurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource TreasuryPopupBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="20"/>
            <Setter Property="Padding"
                    Value="20"/>
        </Style>

        <Style x:Key="TreasuryPopupLabelStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TreasuryPopupTextBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TreasuryPopupPrimaryButtonStyle"
                TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="MinWidth"
                    Value="118"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
            <Setter Property="Padding"
                    Value="18,8"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="{StaticResource TreasuryPopupAccentBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource TreasuryPopupAccentBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreasuryPopupSecondaryButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource TreasuryPopupPrimaryButtonStyle}">
            <Setter Property="Foreground"
                    Value="{StaticResource TreasuryPopupTextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource TreasuryPopupAltBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource TreasuryPopupBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource TreasuryPopupCardStyle}"
                Background="{StaticResource TreasuryPopupAccentPaleBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               Text="إضافة حركة خزينة"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TreasuryPopupTextBrush}"/>
                    <TextBlock Margin="0,8,0,0"
                               Text="سجل حركة الخزينة من فورم واحد، وسيتم حفظها مباشرة في قاعدة البيانات."
                               Foreground="{StaticResource TreasuryPopupMutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Width="58"
                        Height="58"
                        CornerRadius="17"
                        Background="{StaticResource TreasuryPopupSurfaceBrush}"
                        BorderBrush="{StaticResource TreasuryPopupBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="+"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TreasuryPopupAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Style="{StaticResource TreasuryPopupCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,12,14">
                    <TextBlock Text="التاريخ"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <DatePicker x:Name="TransactionDatePicker"
                                AutomationProperties.AutomationId="TreasuryTransactionDatePicker"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                        Margin="0,0,0,14">
                    <TextBlock Text="نوع الحركة"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <ComboBox x:Name="TransactionTypeComboBox"
                              AutomationProperties.AutomationId="TreasuryTransactionTypeComboBox"
                              Style="{StaticResource AppComboBoxStyle}">
                        <ComboBoxItem Content="إيراد"/>
                        <ComboBoxItem Content="صرف"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        Margin="0,0,12,14">
                    <TextBlock Text="المبلغ"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <TextBox x:Name="AmountTextBox"
                             AutomationProperties.AutomationId="TreasuryAmountTextBox"
                             Style="{StaticResource AppTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,14">
                    <TextBlock Text="طريقة الدفع"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <ComboBox x:Name="PaymentMethodComboBox"
                              AutomationProperties.AutomationId="TreasuryPaymentMethodComboBox"
                              Style="{StaticResource AppComboBoxStyle}">
                        <ComboBoxItem Content="نقدي"/>
                        <ComboBoxItem Content="تحويل بنكي"/>
                        <ComboBoxItem Content="بطاقة"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,14">
                    <TextBlock Text="الوصف"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             AutomationProperties.AutomationId="TreasuryDescriptionTextBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             Height="72"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Padding="12,8"/>
                </StackPanel>

                <StackPanel Grid.Row="3"
                        Margin="0,0,12,0">
                    <TextBlock Text="مرتبط بـ"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <TextBox x:Name="RelatedEntityTypeTextBox"
                             AutomationProperties.AutomationId="TreasuryRelatedEntityTypeTextBox"
                             Style="{StaticResource AppTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,0,0,0">
                    <TextBlock Text="رقم المرتبط"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <TextBox x:Name="RelatedEntityIdTextBox"
                             AutomationProperties.AutomationId="TreasuryRelatedEntityIdTextBox"
                             Style="{StaticResource AppTextBoxStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource TreasuryPopupCardStyle}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ملاحظات"
                            Style="{StaticResource TreasuryPopupLabelStyle}"/>
                    <TextBox x:Name="NotesTextBox"
                             AutomationProperties.AutomationId="TreasuryNotesTextBox"
                             MinHeight="58"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource AppTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="16,0,0,0">
                    <Button Content="حفظ"
                            AutomationProperties.AutomationId="TreasurySaveButton"
                            Style="{StaticResource TreasuryPopupPrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                    <Button Content="إلغاء"
                            AutomationProperties.AutomationId="TreasuryCancelButton"
                            Style="{StaticResource TreasuryPopupSecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
