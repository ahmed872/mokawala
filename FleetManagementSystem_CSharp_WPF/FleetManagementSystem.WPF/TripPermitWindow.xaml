<Window x:Class="FleetManagementSystem.WPF.TripPermitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نموذج تشغيل A5"
        Width="620"
        Height="820"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#EDF2EF">
    <Window.Resources>
        <SolidColorBrush x:Key="PermitInkBrush" Color="#1F2A2E" />
        <SolidColorBrush x:Key="PermitMutedBrush" Color="#5E6B70" />
        <SolidColorBrush x:Key="PermitBorderBrush" Color="#1F2A2E" />
        <SolidColorBrush x:Key="PermitAccentBrush" Color="#53766A" />

        <Style x:Key="PermitLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PermitMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PermitValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PermitInkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="PermitCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PermitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="54" />
        </Style>

        <Style x:Key="PermitButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PermitAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PermitAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="FormRoot"
                    Width="559"
                    Height="794"
                    Background="White"
                    BorderBrush="#B8C5BE"
                    BorderThickness="1"
                    Padding="24"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CompanyNameTextBlock"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PermitInkBrush}" />
                            <TextBlock x:Name="CompanyAddressTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource PermitMutedBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="82"
                                Height="50"
                                BorderBrush="{StaticResource PermitBorderBrush}"
                                BorderThickness="1"
                                Padding="6">
                            <TextBlock Text="A5"
                                       FlowDirection="LeftToRight"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PermitAccentBrush}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,18,0,16"
                            BorderBrush="{StaticResource PermitBorderBrush}"
                            BorderThickness="0,2,0,2"
                            Padding="0,10">
                        <TextBlock Text="نموذج تشغيل مركبة"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PermitInkBrush}" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="رقم التشغيل" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="TripNumberTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="تاريخ التشغيل" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="TripDateTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="حالة التشغيل" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="TripStatusTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="رقم السيارة" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="VehiclePlateTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="النوع / الموديل" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="VehicleModelTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="رقم الشاسيه" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="VehicleChassisTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="رقم الموتور" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="VehicleEngineTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="بداية الترخيص" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="RegistrationStartTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="نهاية الترخيص" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="RegistrationExpiryTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="بيانات التأمين" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="InsuranceDetailsTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="اسم السائق" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="DriverNameTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="الموصي" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="RequesterNameTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="المشرف" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="SupervisorNameTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PermitCellStyle}">
                            <StackPanel>
                                <TextBlock Text="المسار" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="RouteTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PermitCellStyle}" MinHeight="92">
                            <StackPanel>
                                <TextBlock Text="الغرض والملاحظات" Style="{StaticResource PermitLabelStyle}" />
                                <TextBlock x:Name="PurposeTextBlock" Style="{StaticResource PermitValueStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{StaticResource PermitBorderBrush}" BorderThickness="0,1,0,0" Margin="0,36,8,0">
                            <TextBlock Text="توقيع السائق" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="Bold" />
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{StaticResource PermitBorderBrush}" BorderThickness="0,1,0,0" Margin="8,36,8,0">
                            <TextBlock Text="توقيع المشرف" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="Bold" />
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource PermitBorderBrush}" BorderThickness="0,1,0,0" Margin="8,36,0,0">
                            <TextBlock Text="اعتماد الإدارة" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>

        <WrapPanel Grid.Row="1"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Left">
            <Button Style="{StaticResource PermitButtonStyle}"
                    Click="PrintButton_Click">
                طباعة
            </Button>
            <Button Style="{StaticResource PermitButtonStyle}"
                    Background="#6B7280"
                    BorderBrush="#6B7280"
                    Click="CloseButton_Click">
                إغلاق
            </Button>
        </WrapPanel>
    </Grid>
</Window>
