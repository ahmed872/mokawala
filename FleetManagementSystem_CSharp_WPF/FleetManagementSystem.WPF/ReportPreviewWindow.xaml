<Window x:Class="FleetManagementSystem.WPF.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة التقرير"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterOwner"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}">
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="90"
                            Click="ZoomOutButton_Click">تصغير</Button>
                    <TextBlock x:Name="ZoomTextBlock"
                               Width="58"
                               Margin="4,0,4,0"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="80"
                            Click="ResetZoomButton_Click">100%</Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="90"
                            Click="ZoomInButton_Click">تكبير</Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="130"
                            Click="PrintButton_Click">طباعة</Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="110"
                            Click="CloseButton_Click">إغلاق</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <FlowDocumentReader x:Name="PreviewDocumentViewer"
                                FlowDirection="RightToLeft"
                                ViewingMode="Scroll"
                                IsFindEnabled="False"
                                Background="{StaticResource SurfaceAltBrush}"/>
        </Border>
    </DockPanel>
</Window>
